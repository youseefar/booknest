MONGODB_URI=
NODE_ENV=development
PORT=5000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set the generated value as SESSION_SECRET in Render's Environment settings.
SESSION_SECRET=
PAYSTACK_SECRET_KEY=
PAYSTACK_MODE=test
APP_URL=http://localhost:5000
FRONTEND_ORIGIN=
SMTP_USER=
SMTP_APP_PASSWORD=
RESEND_API_KEY=
# Server-side Cloudinary credentials for property videos only; never expose the API secret in browser code.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Google sign-in (optional). See GOOGLE_AUTH.md. Leave blank to hide the Google buttons.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: defaults to APP_URL + /auth/google/callback
GOOGLE_CALLBACK_URL=
# Optional public support address shown on the Contact page. Leave blank to show a notice instead.
SUPPORT_EMAIL=

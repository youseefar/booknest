<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="/jacobrent-mark.svg">
    <title>Payment Receipt - JacobRent</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <script src="/js/theme.js"></script>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-soft">
    <main class="container receipt-page">
        <div class="receipt-toolbar">
            <a class="btn btn-outline-secondary" href="/my-bookings"><i class="bi bi-arrow-left me-2" aria-hidden="true"></i>My bookings</a>
            <button class="btn btn-primary" type="button" onclick="window.print()"><i class="bi bi-printer me-2" aria-hidden="true"></i>Print / Save PDF</button>
        </div>
        <article class="receipt-sheet">
            <header class="receipt-header">
                <div>
                    <a class="receipt-brand" href="/">JacobRent</a>
                    <p>Student rental payment receipt</p>
                </div>
                <span class="receipt-paid"><i class="bi bi-check-circle-fill me-1" aria-hidden="true"></i>Payment verified</span>
            </header>
            <section class="receipt-total">
                <span>Amount paid</span>
                <strong>₦<%= (receipt.amountKobo / 100).toLocaleString('en-NG', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></strong>
                <span>Paid on <%= new Date(receipt.paidAt).toLocaleString('en-NG', { dateStyle: 'medium', timeStyle: 'short' }) %></span>
            </section>
            <section class="receipt-details" aria-label="Receipt details">
                <div><span>Receipt reference</span><strong><%= receipt.reference %></strong></div>
                <div><span>Payment method</span><strong>Paystack</strong></div>
                <div><span>Student</span><strong><%= user.name %></strong></div>
                <div><span>Email</span><strong><%= user.email %></strong></div>
                <div><span>Property</span><strong><%= booking.propertyId.title %></strong></div>
                <div><span>Location</span><strong><%= booking.propertyId.location %></strong></div>
                <% if (receipt.expiresAt) { %><div><span>Stay expires</span><strong><%= new Date(receipt.expiresAt).toLocaleDateString('en-NG', { dateStyle: 'medium' }) %></strong></div><% } %>
            </section>
            <footer class="receipt-footer">Keep this receipt for your records. Payment status was verified with Paystack.</footer>
        </article>
    </main>
</body>
</html>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= property.title %> - FUTB Housing</title>
    <link rel="icon" type="image/png" href="/futb-crest.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <script src="/js/theme.js"></script>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="bg-soft">
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top shadow-sm">
        <div class="container">
            <a class="navbar-brand brand fw-bold" href="/" aria-label="FUTB Housing home"><img class="brand-logo" src="/futb-crest.png" alt="Federal University of Technology Babura crest">FUTB <span class="text-success">Housing</span></a>
            <div class="d-flex gap-3 align-items-center">
                <a class="nav-link text-dark" href="/properties"><i class="bi bi-building me-1"></i>Properties</a>
                <% if (user) { %>
                    <a class="nav-link text-dark" href="/dashboard"><i class="bi bi-speedometer2 me-1"></i>Dashboard</a>
                    <a class="nav-link text-dark" href="/profile"><i class="bi bi-person-circle me-1"></i>Profile</a>
                    <a class="nav-link text-dark" href="/logout"><i class="bi bi-box-arrow-right me-1"></i>Logout</a>
                <% } else { %>
                    <a class="nav-link text-dark" href="/login"><i class="bi bi-person-circle me-1"></i>Login</a>
                <% } %>
            </div>
        </div>
    </nav>

    <main class="container py-5">
        <div class="row g-4">
            <div class="col-lg-7">
                <div class="detail-gallery glass-card overflow-hidden">
                    <% if (property.videoUrl) { %>
                        <video class="property-video w-100" controls preload="metadata" playsinline>
                            <source src="<%= property.videoUrl %>">
                            Your browser does not support video playback.
                        </video>
                    <% } else if (property.images && property.images.length) { %>
                        <div id="propertyCarousel" class="carousel slide" data-bs-ride="carousel">
                            <div class="carousel-inner">
                                <% property.images.forEach((image, index) => { %>
                                    <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
                                        <img src="<%= image %>" class="d-block w-100" alt="<%= property.title %>" style="height: 520px; object-fit: cover;">
                                    </div>
                                <% }); %>
                            </div>
                            <button class="carousel-control-prev" type="button" data-bs-target="#propertyCarousel" data-bs-slide="prev">
                                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                <span class="visually-hidden">Previous</span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#propertyCarousel" data-bs-slide="next">
                                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                <span class="visually-hidden">Next</span>
                            </button>
                        </div>
                    <% } else { %>
                        <div class="d-flex align-items-center justify-content-center bg-gradient-rent text-white" style="height: 520px;">
                            <i class="bi bi-house-heart display-1"></i>
                        </div>
                    <% } %>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="glass-card p-4 h-100">
                    <span class="eyebrow text-uppercase"><%= property.status === 'rented' ? 'Booked home' : 'Verified rental' %></span>
                    <h1 class="h2 fw-bold mb-3"><%= property.title %></h1>
                    <% if (property.averageRating) { %>
                        <p class="mb-3 text-warning-emphasis"><i class="bi bi-star-fill me-1"></i><strong><%= property.averageRating.toFixed(1) %></strong><span class="text-muted"> / 5 · <%= property.reviews.length %> review<%= property.reviews.length === 1 ? '' : 's' %></span></p>
                    <% } else { %>
                        <p class="mb-3 text-muted"><i class="bi bi-star me-1"></i>No ratings yet</p>
                    <% } %>
                    <div class="d-flex align-items-center gap-3 mb-3 text-success fw-semibold">
                        <span><i class="bi bi-geo-alt-fill me-1"></i><%= property.location %></span>
                        <span class="badge text-bg-success-subtle text-success"><%= property.status %></span>
                    </div>
                    <div class="fs-4 fw-bold text-dark mb-3">₦<%= property.price.toLocaleString() %><span class="text-muted fs-6">/month</span></div>
                    <p class="text-muted"><%= property.description %></p>

                    <div class="row g-2 mb-4">
                        <div class="col-6"><div class="info-pill"><i class="bi bi-pin-map-fill me-2"></i><%= property.address %></div></div>
                        <div class="col-6"><div class="info-pill"><i class="bi bi-star-fill me-2"></i><%= property.amenities && property.amenities.length ? property.amenities.length : 0 %> amenities</div></div>
                    </div>

                    <% if (property.amenities && property.amenities.length) { %>
                        <div class="mb-4">
                            <h3 class="h5 fw-bold mb-3">Included amenities</h3>
                            <div class="d-flex flex-wrap gap-2">
                                <% property.amenities.forEach(amenity => { %>
                                    <span class="amenity-badge"><i class="bi bi-check-circle-fill me-1"></i><%= amenity %></span>
                                <% }); %>
                            </div>
                        </div>
                    <% } %>

                    <div class="border-top pt-4 mb-3">
                        <h3 class="h5 fw-bold mb-2">Landlord info</h3>
                        <p class="mb-1"><i class="bi bi-person-fill me-2"></i><strong><%= property.landlordId.name %></strong></p>
                        <p class="mb-1"><i class="bi bi-telephone-fill me-2"></i><%= property.landlordId.phone || 'Phone number not provided' %></p>
                        <p class="mb-0"><i class="bi bi-envelope-fill me-2"></i><%= property.landlordId.email %></p>
                    </div>

                    <% if (property.status === 'rented') { %>
                        <button type="button" class="btn btn-secondary btn-lg w-100 mt-3" disabled><i class="bi bi-check-circle me-2"></i>Booked</button>
                    <% } else if (user && user.role === 'student' && property.status === 'available' && property.verificationStatus === 'verified' && typeof paystackReady !== 'undefined' && paystackReady) { %>
                        <form method="POST" action="/payments/properties/<%= property._id %>/initialize" class="mt-3">
                            <button type="submit" class="btn btn-primary btn-lg w-100"><i class="bi bi-credit-card me-2"></i>Pay ₦<%= property.price.toLocaleString() %> with Paystack</button>
                            <p class="small text-muted text-center mt-2 mb-0">Secure <%= typeof paystackMode !== 'undefined' ? paystackMode : 'test' %>-mode checkout · listed monthly price</p>
                        </form>
                    <% } else if (user && user.role === 'student' && property.status === 'available' && property.verificationStatus === 'verified') { %>
                        <div class="alert alert-info mt-3 mb-0" role="status">Online payment isn’t available for this listing in <%= typeof paystackMode !== 'undefined' ? paystackMode : 'current' %> mode yet. Please contact the landlord or try again later.</div>
                    <% } else if (!user) { %>
                        <a href="/login?returnTo=%2Fproperty%2F<%= property._id %>" class="btn btn-primary w-100"><i class="bi bi-box-arrow-in-right me-2"></i>Sign in to book this home</a>
                        <p class="small text-muted text-center mt-2 mb-0">New here? Your home will be waiting after you create an account.</p>
                    <% } %>
                </div>
            </div>
        </div>

        <section class="property-reviews mt-5" aria-labelledby="reviews-heading">
            <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
                <div><span class="eyebrow text-uppercase">Student feedback</span><h2 id="reviews-heading" class="h3 mb-0">Ratings and comments</h2></div>
                <span class="text-muted"><%= property.reviews.length %> review<%= property.reviews.length === 1 ? '' : 's' %></span>
            </div>
            <% if (reviewResult === 'submitted') { %><div class="alert alert-success" role="status">Your review was added.</div><% } %>
            <% if (reviewResult === 'duplicate') { %><div class="alert alert-info" role="status">You have already reviewed this home.</div><% } %>
            <% if (reviewResult === 'invalid') { %><div class="alert alert-warning" role="status">Choose a rating and enter a comment of 2 to 1,000 characters.</div><% } %>

            <% if (reviewEligible && !reviewed) { %>
                <form class="glass-card p-4 mb-4" method="POST" action="/property/<%= property._id %>/reviews">
                    <div class="row g-3 align-items-end">
                        <div class="col-sm-4 col-md-3">
                            <label class="form-label" for="review-rating">Your rating</label>
                            <select class="form-select" id="review-rating" name="rating" required>
                                <option value="">Choose stars</option>
                                <option value="5">5 stars</option><option value="4">4 stars</option><option value="3">3 stars</option><option value="2">2 stars</option><option value="1">1 star</option>
                            </select>
                        </div>
                        <div class="col-md-9">
                            <label class="form-label" for="review-comment">Comment</label>
                            <textarea class="form-control" id="review-comment" name="comment" rows="3" minlength="2" maxlength="1000" required placeholder="How was your stay?"></textarea>
                        </div>
                        <div class="col-12"><button class="btn btn-primary" type="submit"><i class="bi bi-chat-square-text me-2"></i>Post review</button></div>
                    </div>
                </form>
            <% } else if (reviewed) { %>
                <p class="text-muted">You have reviewed this home.</p>
            <% } %>

            <div class="row g-3">
                <% property.reviews.slice().sort((left, right) => new Date(right.createdAt) - new Date(left.createdAt)).forEach(review => { %>
                    <div class="col-12"><article class="glass-card p-4">
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-2">
                            <strong><%= review.userId?.name || 'Student' %></strong>
                            <span class="text-warning-emphasis" aria-label="<%= review.rating %> out of 5 stars"><i class="bi bi-star-fill me-1"></i><%= review.rating %>/5</span>
                        </div>
                        <p class="mb-2"><%= review.comment %></p>
                        <small class="text-muted"><%= new Date(review.createdAt).toLocaleDateString() %></small>
                    </article></div>
                <% }); %>
                <% if (!property.reviews.length) { %><div class="col-12"><p class="text-muted">No one has reviewed this home yet.</p></div><% } %>
            </div>
        </section>

        <div class="mt-4">
            <a href="/properties" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-2"></i>Back to properties</a>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <%- include('partials/legal-footer') %>
</body>
</html>
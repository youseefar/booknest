<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Inquiries - FUTB Housing</title><link rel="stylesheet" href="/css/style.css"></head>
<body>
<nav class="navbar"><div class="container nav-inner"><a class="brand" href="/"><span class="brand-mark">F</span> FUTB <em>Housing</em></a><ul><li><a href="/dashboard">Dashboard</a></li><li><a href="/properties">Properties</a></li><li><a href="/logout">Logout</a></li></ul></div></nav>
<main class="container"><div class="page-heading"><div><span class="eyebrow"><%= landlordView ? 'LANDLORD INBOX' : 'YOUR ACTIVITY' %></span><h2><%= landlordView ? 'Property inquiries' : 'My inquiries' %></h2><p><%= landlordView ? 'Respond to students interested in your listings.' : 'Keep track of every conversation about a home.' %></p></div></div>
<div class="inquiry-list"><% if (!inquiries.length) { %><div class="empty-state"><strong>No inquiries yet.</strong><p>New activity will appear here.</p></div><% } %><% inquiries.forEach(inquiry => { %><article class="inquiry-card"><div class="inquiry-top"><div><span class="eyebrow"><%= inquiry.propertyId ? inquiry.propertyId.title : 'Property unavailable' %></span><h3><%= landlordView ? (inquiry.studentId ? inquiry.studentId.name : 'Student') : (inquiry.propertyId ? inquiry.propertyId.location : 'Property unavailable') %></h3></div><span class="badge badge-<%= inquiry.status %>"><%= inquiry.status %></span></div><p class="inquiry-message"><%= inquiry.message || 'No message provided.' %></p><div class="inquiry-meta"><span><%= new Date(inquiry.timestamp).toLocaleDateString() %></span><% if (landlordView && inquiry.studentId) { %><span><%= inquiry.studentId.email %></span><% } %></div><% if (landlordView) { %><form class="inline-form" method="POST" action="/inquiries/<%= inquiry._id %>/status"><select name="status"><option value="pending" <%= inquiry.status === 'pending' ? 'selected' : '' %>>Pending</option><option value="viewed" <%= inquiry.status === 'viewed' ? 'selected' : '' %>>Viewed</option><option value="approved" <%= inquiry.status === 'approved' ? 'selected' : '' %>>Approve</option><option value="rejected" <%= inquiry.status === 'rejected' ? 'selected' : '' %>>Reject</option></select><button class="btn" type="submit">Update</button></form><% } %></article><% }) %></div></main>
</body></html>

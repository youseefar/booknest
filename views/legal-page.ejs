<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="<%= page.summary %>">
    <link rel="icon" type="image/svg+xml" href="/jacobrent-mark.svg">
    <title><%= page.title %> - Jacob Estate</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <script src="/js/theme.js"></script>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-soft">
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top shadow-sm">
        <div class="container">
            <a class="navbar-brand brand fw-bold" href="/" aria-label="Jacob Estate home"><img class="brand-logo" src="/jacobrent-mark.svg" alt="Jacob Estate mark">Jacob Estate</a>
            <div class="d-flex gap-3 align-items-center">
                <a class="nav-link text-dark" href="/properties"><i class="bi bi-buildings me-1"></i>Browse homes</a>
                <a class="nav-link text-dark" href="/contact">Contact</a>
            </div>
        </div>
    </nav>
    <main class="container legal-page py-5">
        <header class="mb-4">
            <span class="eyebrow text-uppercase">Jacob Estate</span>
            <h1 class="fw-bold"><%= page.title %></h1>
            <% if (page.slug !== 'about' && page.slug !== 'contact' && page.slug !== 'faq') { %>
                <p class="text-muted mb-0">Last updated: <%= lastUpdated %></p>
            <% } %>
        </header>
        <article class="legal-document">
            <% (page.sections || []).forEach(section => { %>
                <section>
                    <h2><%= section.heading %></h2>
                    <% (section.paragraphs || []).forEach(text => { %><p><%= text %></p><% }) %>
                    <% if (section.items) { %>
                        <ul class="legal-list">
                            <% section.items.forEach(item => { %><li><%= item %></li><% }) %>
                        </ul>
                    <% } %>
                </section>
            <% }) %>
            <% if (page.faqs) { %>
                <section>
                    <% page.faqs.forEach(([question, answer]) => { %>
                        <details class="faq-item">
                            <summary><%= question %></summary>
                            <p><%= answer %></p>
                        </details>
                    <% }) %>
                </section>
            <% } %>
            <% if (page.slug === 'contact') { %>
                <section>
                    <h2>Support email</h2>
                    <% if (supportEmail) { %>
                        <p><a href="mailto:<%= supportEmail %>"><%= supportEmail %></a></p>
                    <% } else { %>
                        <p>A public support email has not been published yet. Please use the booking or inquiry option on a property page for listing questions.</p>
                    <% } %>
                </section>
            <% } %>
        </article>
    </main>
    <%- include('partials/legal-footer') %>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Set up your payout account - Jacob Estate</title>
    <link rel="icon" type="image/svg+xml" href="/jacobrent-mark.svg">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <script src="/js/theme.js"></script>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/onboarding.css">
</head>
<body class="bg-soft onboarding">
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm">
        <div class="container">
            <a class="navbar-brand brand fw-bold" href="/" aria-label="Jacob Estate home"><img class="brand-logo" src="/jacobrent-mark.svg" alt="">Jacob Estate</a>
            <div class="d-flex gap-3 align-items-center"><a class="nav-link text-dark" href="/logout"><i class="bi bi-box-arrow-right me-1"></i>Log out</a></div>
        </div>
    </nav>
    <main class="onboarding-main">
        <ol class="onboarding-steps" aria-label="Setup progress">
            <li class="is-done"><span><i class="bi bi-check-lg"></i></span>Account created</li>
            <li class="is-current" aria-current="step"><span>2</span>Payout account</li>
            <li><span>3</span>Your dashboard</li>
        </ol>
        <section class="onboarding-card">
            <div class="onboarding-icon"><i class="bi bi-bank"></i></div>
            <span class="eyebrow text-uppercase">One last step</span>
            <h1>Where should we send your rent?</h1>
            <p class="onboarding-lede">Welcome, <%= user.name.split(' ')[0] %>. Add the bank account that should receive your rental payments. Paystack checks the account name before it is saved, and you can open your dashboard as soon as it is done.</p>
            <% if (typeof message !== 'undefined' && message) { %><div class="alert alert-danger" role="alert"><%= message %></div><% } %>
            <form id="payout-account-form" class="row g-3" method="POST" action="/payments/payout-account" data-selected-bank="">
                <input type="hidden" name="onboarding" value="1">
                <div class="col-12">
                    <label class="form-label" for="payout-bank">Bank</label>
                    <input id="payout-bank" class="form-control form-control-lg" type="search" list="payout-bank-options" placeholder="Type to search banks" autocomplete="off" required disabled>
                    <datalist id="payout-bank-options"></datalist>
                    <input id="payout-bank-code" name="bankCode" type="hidden">
                </div>
                <div class="col-12">
                    <label class="form-label" for="payout-account-number">Account number</label>
                    <input id="payout-account-number" name="accountNumber" class="form-control form-control-lg" type="text" inputmode="numeric" autocomplete="off" pattern="[0-9]{10}" minlength="10" maxlength="10" placeholder="10-digit account number" required>
                </div>
                <input id="verified-account-name" type="hidden" name="verifiedAccountName">
                <div class="col-12"><p id="payout-account-status" class="small mb-0" role="status" aria-live="polite"></p></div>
                <div class="col-12 onboarding-actions">
                    <button id="verify-payout-account" class="btn btn-outline-dark" type="button"><i class="bi bi-shield-check me-2"></i>Verify account</button>
                    <button id="save-payout-account" class="btn btn-primary btn-lg" type="submit" disabled>Save and continue <i class="bi bi-arrow-right ms-2"></i></button>
                </div>
            </form>
            <p class="onboarding-note"><i class="bi bi-lock me-2"></i>Only the account name and last four digits are kept on your profile. Jacob Estate keeps a 1% service fee and sends the rest of each rental payment to this account.</p>
        </section>
    </main>
    <%- include('partials/legal-footer') %>
    <script src="/js/payout-account.js" defer></script>
</body>
</html>

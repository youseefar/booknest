<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Moderation - FUTB Housing</title>
    <link rel="icon" type="image/png" href="/futb-crest.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <script src="/js/theme.js"></script>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-soft admin-dashboard-page">
<nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top shadow-sm">
    <div class="container">
        <a class="navbar-brand brand fw-bold" href="/" aria-label="FUTB Housing home"><img class="brand-logo" src="/futb-crest.png" alt="Federal University of Technology Babura crest">FUTB <span class="text-success">Housing</span></a>
        <div class="d-flex gap-3 align-items-center">
            <a class="nav-link text-dark" href="/dashboard"><i class="bi bi-speedometer2 me-1"></i>Dashboard</a>
            <a class="nav-link text-dark" href="/profile"><i class="bi bi-person-circle me-1"></i>Profile</a>
            <a class="nav-link text-dark" href="/logout"><i class="bi bi-box-arrow-right me-1"></i>Logout</a>
        </div>
    </div>
</nav>
<main class="container admin-console py-5">
    <div class="admin-page-heading mb-4">
        <div>
            <span class="eyebrow text-uppercase">Admin console</span>
            <h1 class="mb-1">Marketplace overview</h1>
            <p class="text-muted mb-0">Review listings, manage accounts, and keep the housing board accurate.</p>
        </div>
        <span class="admin-live-label"><span></span>Admin access</span>
    </div>

    <% if (adminMessage === 'active-stay') { %>
        <div class="alert alert-warning" role="status">This home has an active paid stay, so it cannot be marked available.</div>
    <% } else if (adminMessage === 'listing-updated') { %>
        <div class="alert alert-success" role="status">Listing status updated.</div>
    <% } %>

    <div class="row g-3 mb-5 admin-metrics">
        <div class="col-6 col-xl-3"><div class="admin-stat-card"><i class="bi bi-people-fill"></i><div><small>All accounts</small><strong><%= userCount %></strong><em><%= studentCount %> students · <%= landlordCount %> landlords</em></div></div></div>
        <div class="col-6 col-xl-3"><div class="admin-stat-card"><i class="bi bi-buildings-fill"></i><div><small>Total listings</small><strong><%= propertyCount %></strong><em>Across the marketplace</em></div></div></div>
        <div class="col-6 col-xl-3"><div class="admin-stat-card"><i class="bi bi-house-check-fill"></i><div><small>Available homes</small><strong><%= availableCount %></strong><em>Verified and bookable</em></div></div></div>
        <div class="col-6 col-xl-3"><div class="admin-stat-card"><i class="bi bi-hourglass-split"></i><div><small>Needs review</small><strong><%= pendingProperties.length %></strong><em>Listings awaiting verification</em></div></div></div>
    </div>

    <section class="admin-console-section mb-5">
        <div class="section-head">
            <h3>Needs review</h3>
            <span class="pill pill-pending"><%= pendingProperties.length %> pending</span>
        </div>
        <div class="airbnb-dashboard-list">
            <% if (!pendingProperties.length) { %>
                <div class="empty-state"><strong>Nothing needs review.</strong><p>All submitted properties have been handled.</p></div>
            <% } %>
            <% pendingProperties.forEach(property => { %>
                <div class="airbnb-list-row admin-row">
                    <span class="airbnb-avatar"><%= property.title.substring(0, 1).toUpperCase() %></span>
                    <span>
                        <strong><%= property.title %></strong>
                        <small><%= property.location %> · Submitted by <%= property.landlordId ? property.landlordId.name : 'Unknown landlord' %></small>
                    </span>
                    <div class="admin-actions">
                        <a class="btn btn-outline-secondary" href="/property/<%= property._id %>"><i class="bi bi-eye me-1"></i>View</a>
                        <form class="inline-form" method="POST" action="/admin/properties/<%= property._id %>/verification">
                            <input type="hidden" name="status" value="verified">
                            <button class="btn btn-success" type="submit">Verify</button>
                        </form>
                        <form class="inline-form" method="POST" action="/admin/properties/<%= property._id %>/verification">
                            <input type="hidden" name="status" value="rejected">
                            <button class="btn btn-outline-danger" type="submit">Reject</button>
                        </form>
                    </div>
                </div>
            <% }) %>
        </div>
    </section>

    <section class="admin-console-section mb-5">
        <div class="section-head">
            <div><span class="eyebrow text-uppercase">Access control</span><h3>All users</h3></div>
            <span class="pill pill-verified"><%= users.length %> shown</span>
        </div>

            <form class="admin-filter-bar mb-3" method="GET" action="/admin">
                <div class="admin-filter-search">
                <input
                    type="search"
                    class="form-control"
                    name="q"
                    value="<%= search %>"
                        placeholder="Search name or email"
                        aria-label="Search accounts by name or email"
                >
            </div>
                <div class="admin-filter-role">
                    <label class="visually-hidden" for="account-role">Filter by role</label>
                    <select id="account-role" class="form-select" name="role">
                        <option value="">All roles</option>
                        <option value="student" <%= role === 'student' ? 'selected' : '' %>>Students</option>
                        <option value="landlord" <%= role === 'landlord' ? 'selected' : '' %>>Landlords</option>
                        <option value="admin" <%= role === 'admin' ? 'selected' : '' %>>Admins</option>
                    </select>
            </div>
                <button class="btn btn-primary" type="submit"><i class="bi bi-search me-1"></i>Find accounts</button>
                <a class="btn btn-outline-secondary" href="/admin">Reset</a>
        </form>

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle bg-white shadow-sm rounded overflow-hidden">
                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Joined</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (!users.length) { %>
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">No users match that name search.</td>
                        </tr>
                    <% } %>
                    <% users.forEach(account => { %>
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="admin-user-avatar"><%= account.name.substring(0, 1).toUpperCase() %></span>
                                    <strong><%= account.name %></strong>
                                </div>
                            </td>
                            <td><%= account.email %></td>
                            <td>
                                <span class="pill pill-<%= account.role === 'admin' ? 'verified' : 'viewed' %>"><%= account.role %></span>
                            </td>
                            <td><%= new Date(account.createdAt).toLocaleDateString() %></td>
                            <td>
                                <% if (account.role !== 'admin') { %>
                                    <form method="POST" action="/admin/users/<%= account._id %>/delete" onsubmit="return confirm('Delete this user and their related data?');">
                                        <button class="btn btn-sm btn-outline-danger" type="submit" aria-label="Delete <%= account.name %>"><i class="bi bi-trash3"></i> Delete</button>
                                    </form>
                                <% } else { %>
                                    <span class="admin-protected"><i class="bi bi-shield-lock me-1"></i>Protected</span>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </section>

    <section class="admin-console-section">
        <div class="section-head admin-listing-heading">
            <div><span class="eyebrow text-uppercase">Inventory</span><h3>Manage listings</h3></div>
            <span class="small text-muted">Showing the 20 most recently updated matches</span>
        </div>
        <form class="admin-filter-bar admin-listing-filters mb-3" method="GET" action="/admin">
            <input type="hidden" name="q" value="<%= search %>">
            <input type="hidden" name="role" value="<%= role %>">
            <div>
                <label class="visually-hidden" for="listing-status">Listing availability</label>
                <select id="listing-status" class="form-select" name="propertyStatus">
                    <option value="">All availability</option>
                    <option value="available" <%= propertyStatus === 'available' ? 'selected' : '' %>>Available</option>
                    <option value="rented" <%= propertyStatus === 'rented' ? 'selected' : '' %>>Booked</option>
                    <option value="maintenance" <%= propertyStatus === 'maintenance' ? 'selected' : '' %>>Maintenance</option>
                </select>
            </div>
            <div>
                <label class="visually-hidden" for="verification-status">Verification status</label>
                <select id="verification-status" class="form-select" name="verificationStatus">
                    <option value="">All verification</option>
                    <option value="pending" <%= verificationStatus === 'pending' ? 'selected' : '' %>>Pending</option>
                    <option value="verified" <%= verificationStatus === 'verified' ? 'selected' : '' %>>Verified</option>
                    <option value="rejected" <%= verificationStatus === 'rejected' ? 'selected' : '' %>>Rejected</option>
                </select>
            </div>
            <button class="btn btn-primary" type="submit">Filter listings</button>
        </form>
        <div class="airbnb-dashboard-list">
            <% recentProperties.forEach(property => { %>
                <div class="airbnb-list-row admin-listing-row">
                    <a class="airbnb-row-link" href="/property/<%= property._id %>">
                        <span class="dashboard-list-thumb">
                            <% if (property.images && property.images.length) { %><img src="<%= property.images[0] %>" alt="<%= property.title %>"><% } else { %><i class="bi bi-house"></i><% } %>
                        </span>
                        <span class="admin-listing-copy">
                            <strong><%= property.title %></strong>
                            <small><%= property.location %> · <%= property.landlordId ? property.landlordId.name : 'Unknown landlord' %></small>
                        </span>
                    </a>
                    <form class="admin-listing-manage" method="POST" action="/admin/properties/<%= property._id %>/manage">
                        <label class="visually-hidden" for="listing-status-<%= property._id %>">Availability for <%= property.title %></label>
                        <select id="listing-status-<%= property._id %>" class="form-select form-select-sm" name="status">
                            <option value="available" <%= property.status === 'available' ? 'selected' : '' %>>Available</option>
                            <option value="rented" <%= property.status === 'rented' ? 'selected' : '' %>>Booked</option>
                            <option value="maintenance" <%= property.status === 'maintenance' ? 'selected' : '' %>>Maintenance</option>
                        </select>
                        <label class="visually-hidden" for="verification-<%= property._id %>">Verification for <%= property.title %></label>
                        <select id="verification-<%= property._id %>" class="form-select form-select-sm" name="verificationStatus">
                            <option value="pending" <%= property.verificationStatus === 'pending' ? 'selected' : '' %>>Pending review</option>
                            <option value="verified" <%= property.verificationStatus === 'verified' ? 'selected' : '' %>>Verified</option>
                            <option value="rejected" <%= property.verificationStatus === 'rejected' ? 'selected' : '' %>>Rejected</option>
                        </select>
                        <button class="btn btn-outline-primary btn-sm" type="submit">Save</button>
                    </form>
                    <form method="POST" action="/admin/properties/<%= property._id %>/delete" onsubmit="return confirm('Delete this property and its booking history?');">
                        <button class="btn btn-outline-danger btn-sm" type="submit" aria-label="Delete <%= property.title %>"><i class="bi bi-trash3"></i></button>
                    </form>
                </div>
            <% }) %>
        </div>
    </section>
</main>
<%- include('partials/legal-footer') %>
</body>
</html>

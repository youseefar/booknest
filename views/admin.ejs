<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Moderation - FUTB Housing</title><link rel="stylesheet" href="/css/style.css"></head>
<body>
<nav class="navbar"><div class="container nav-inner"><a class="brand" href="/"><span class="brand-mark">F</span> FUTB <em>Housing</em></a><ul><li><a href="/dashboard">Dashboard</a></li><li><a href="/logout">Logout</a></li></ul></div></nav>
<main class="container"><div class="page-heading"><div><span class="eyebrow">ADMIN CONSOLE</span><h2>Review listings</h2><p>Keep the marketplace accurate, useful, and trusted.</p></div></div><section><div class="section-head"><h3>Needs review</h3><span class="role-pill"><%= pendingProperties.length %> pending</span></div><div class="dashboard-list"><% if (!pendingProperties.length) { %><div class="empty-state"><strong>Nothing needs review.</strong><p>All submitted properties have been handled.</p></div><% } %><% pendingProperties.forEach(property => { %><div class="listing-row"><span class="listing-avatar"><%= property.title.substring(0, 1).toUpperCase() %></span><span><strong><%= property.title %></strong><small><%= property.location %> · Submitted by <%= property.landlordId ? property.landlordId.name : 'Unknown landlord' %></small></span><form class="inline-form" method="POST" action="/admin/properties/<%= property._id %>/verification"><input type="hidden" name="status" value="verified"><button class="btn" type="submit">Verify</button></form><form class="inline-form" method="POST" action="/admin/properties/<%= property._id %>/verification"><input type="hidden" name="status" value="rejected"><button class="btn btn-danger" type="submit">Reject</button></form></div><% }) %></div></section><section><div class="section-head"><h3>Recent listings</h3></div><div class="dashboard-list"><% recentProperties.forEach(property => { %><div class="listing-row"><span class="listing-avatar"><%= property.title.substring(0, 1).toUpperCase() %></span><span><strong><%= property.title %></strong><small><%= property.location %></small></span><span class="badge badge-<%= property.verificationStatus %>"><%= property.verificationStatus %></span></div><% }) %></div></section></main>
</body></html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Property - FUTB Housing</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <script src="/js/theme.js"></script>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-soft">
<nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top shadow-sm">
    <div class="container">
        <a class="navbar-brand brand fw-bold" href="/" aria-label="FUTB Housing home"><img class="brand-logo" src="/futb-crest.png" alt="Federal University of Technology Babura crest">FUTB <span class="text-success">Housing</span></a>
        <div class="d-flex gap-3 align-items-center">
            <a class="nav-link text-dark" href="/dashboard"><i class="bi bi-speedometer2 me-1"></i>Dashboard</a>
            <a class="nav-link text-dark" href="/profile"><i class="bi bi-person-circle me-1"></i>Profile</a>
            <a class="nav-link text-dark" href="/logout"><i class="bi bi-box-arrow-right me-1"></i>Logout</a>
        </div>
    </div>
</nav>
<main class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="glass-card form-card p-4 p-lg-5">
                <div class="text-center mb-4">
                    <span class="eyebrow text-uppercase">Landlord studio</span>
                    <h1 class="display-6 fw-bold mb-2">Edit your rental</h1>
                    <p class="text-muted mb-0">Changes will return the listing for another verification review.</p>
                </div>
                <form method="POST" action="/property/<%= property._id %>/edit" enctype="multipart/form-data" class="row g-3">
                    <div class="col-12"><label class="form-label" for="title">Property title</label><input class="form-control" id="title" name="title" value="<%= property.title %>" required></div>
                    <div class="col-12"><label class="form-label" for="description">Description</label><textarea class="form-control" id="description" name="description" rows="5" required><%= property.description %></textarea></div>
                    <div class="col-md-6"><label class="form-label" for="price">Monthly price</label><input class="form-control" id="price" type="number" name="price" value="<%= property.price %>" required></div>
                    <div class="col-md-6"><label class="form-label" for="location">Area</label><input class="form-control" id="location" name="location" value="<%= property.location %>" required></div>
                    <div class="col-12"><label class="form-label" for="address">Street address</label><input class="form-control" id="address" name="address" value="<%= property.address %>" required></div>
                    <div class="col-12"><label class="form-label" for="amenities">Amenities</label><input class="form-control" id="amenities" name="amenities" value="<%= property.amenities.join(', ') %>"></div>
                    <div class="col-12"><label class="form-label" for="images">Update photos</label><input class="form-control" id="images" type="file" name="images" accept="image/*" multiple><div class="form-text">Leave empty to keep the current photos.</div></div>
                    <div class="col-12 d-grid gap-2 d-md-flex justify-content-md-between pt-3"><a href="/dashboard" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-2"></i>Back</a><button class="btn btn-primary btn-lg px-4" type="submit"><i class="bi bi-check2-circle me-2"></i>Save changes</button></div>
                </form>
            </div>
        </div>
    </div>
</main>
</body></html>

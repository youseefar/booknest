<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Property - Jacob Estate</title>
    <link rel="icon" type="image/svg+xml" href="/jacobrent-mark.svg">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <script src="/js/theme.js"></script>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-soft">
<nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top shadow-sm">
    <div class="container">
        <a class="navbar-brand brand fw-bold" href="/" aria-label="Jacob Estate home"><img class="brand-logo" src="/jacobrent-mark.svg" alt="Jacob Estate mark">Jacob Estate</a>
        <div class="d-flex gap-3 align-items-center">
            <a class="nav-link text-dark" href="/dashboard"><i class="bi bi-speedometer2 me-1"></i>Dashboard</a>
            <a class="nav-link text-dark" href="/profile"><i class="bi bi-person-circle me-1"></i>Profile</a>
            <a class="nav-link text-dark" href="/logout"><i class="bi bi-box-arrow-right me-1"></i>Logout</a>
        </div>
    </div>
</nav>
<main class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="glass-card form-card p-4 p-lg-5">
                <div class="text-center mb-4">
                    <span class="eyebrow text-uppercase">Property workspace</span>
                    <h1 class="display-6 fw-bold mb-2">Edit your property</h1>
                    <p class="text-muted mb-0">Changes will return the listing for another verification review.</p>
                </div>
                <form method="POST" action="/property/<%= property._id %>/edit" class="row g-3">
                    <div class="col-12"><label class="form-label" for="title">Property title</label><input class="form-control" id="title" name="title" maxlength="120" value="<%= property.title %>" required></div>
                    <div class="col-md-6"><label class="form-label" for="listingType">Listing type</label><select class="form-select" id="listingType" name="listingType" required><option value="rent" <%= property.listingType === 'rent' ? 'selected' : '' %>>For rent</option><option value="sale" <%= property.listingType === 'sale' ? 'selected' : '' %>>For sale</option></select></div>
                    <div class="col-12"><label class="form-label" for="description">Description</label><textarea class="form-control" id="description" name="description" rows="5" maxlength="3000" required><%= property.description %></textarea></div>
                    <div class="col-md-6"><label class="form-label" for="price">Price <span class="text-muted">(monthly for rent; asking price for sale)</span></label><input class="form-control" id="price" type="number" name="price" min="1" value="<%= property.price %>" required></div>
                    <div class="col-md-6"><label class="form-label" for="location">Area</label><input class="form-control" id="location" name="location" maxlength="120" value="<%= property.location %>" required></div>
                    <div class="col-md-6"><label class="form-label" for="bedrooms">Bedrooms <span class="text-muted">(optional)</span></label><input class="form-control" id="bedrooms" type="number" name="bedrooms" min="0" max="50" step="1" inputmode="numeric" value="<%= property.bedrooms ?? '' %>"></div>
                    <div class="col-md-6"><label class="form-label" for="bathrooms">Bathrooms <span class="text-muted">(optional)</span></label><input class="form-control" id="bathrooms" type="number" name="bathrooms" min="0" max="50" step="1" inputmode="numeric" value="<%= property.bathrooms ?? '' %>"></div>
                    <div class="col-12"><label class="form-label" for="address">Street address</label><input class="form-control" id="address" name="address" maxlength="240" value="<%= property.address %>" required></div>
                    <div class="col-12"><label class="form-label" for="amenities">Amenities</label><input class="form-control" id="amenities" name="amenities" value="<%= property.amenities.join(', ') %>"></div>
                    <div class="col-12 d-grid gap-2 d-md-flex justify-content-md-between pt-3"><a href="/dashboard" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-2"></i>Back</a><button class="btn btn-primary btn-lg px-4" type="submit"><i class="bi bi-check2-circle me-2"></i>Save changes</button></div>
                </form>
            </div>
        </div>
    </div>
    <section class="glass-card form-card p-4 p-lg-5 mt-4 mb-5">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
            <div>
                <span class="eyebrow text-uppercase">Listing media</span>
                <h2 class="h4 mb-1">Property video</h2>
                <p class="text-muted mb-0">Upload an MP4, MOV, or WebM video up to 50 MB.</p>
            </div>
            <% if (property.videoUrl) { %>
                <span class="badge text-bg-success">Video added</span>
            <% } %>
        </div>
        <% if (typeof videoResult !== 'undefined' && videoResult === 'updated') { %>
            <div class="alert alert-success" role="status">Property video updated. The listing is waiting for verification.</div>
        <% } else if (typeof videoResult !== 'undefined' && videoResult === 'deleted') { %>
            <div class="alert alert-success" role="status">Property video removed.</div>
        <% } %>
        <% if (property.videoUrl) { %>
            <video class="property-video-manage mb-3" controls preload="none" playsinline>
                <source src="<%= property.videoUrl %>" type="video/<%= property.videoFormat || 'mp4' %>">
                Your browser does not support video playback.
            </video>
        <% } %>
        <form method="POST" action="/property/<%= property._id %>/video" enctype="multipart/form-data" class="row g-3 align-items-end">
            <div class="col-lg-8">
                <label class="form-label" for="property-video"><%= property.videoUrl ? 'Replace video' : 'Choose video' %></label>
                <input class="form-control" id="property-video" type="file" name="video" accept="video/mp4,video/quicktime,video/webm" required>
            </div>
            <div class="col-lg-4">
                <button class="btn btn-primary w-100" type="submit"><i class="bi bi-cloud-upload me-2"></i><%= property.videoUrl ? 'Upload replacement' : 'Upload video' %></button>
            </div>
        </form>
        <% if (property.videoUrl) { %>
            <form method="POST" action="/property/<%= property._id %>/video/delete" class="mt-3" data-confirm-title="Remove property video?" data-confirm-message="This removes the video from the listing and queues its Cloudinary asset for deletion." data-confirm-action="Remove video" data-confirm-variant="danger">
                <button class="btn btn-outline-danger" type="submit"><i class="bi bi-trash3 me-2"></i>Remove video</button>
            </form>
        <% } %>
    </section>
    <%- include('partials/legal-footer') %>
</body></html>

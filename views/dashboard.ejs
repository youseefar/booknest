<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - JacobRent</title>
    <link rel="icon" type="image/svg+xml" href="/jacobrent-mark.svg">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <script src="/js/theme.js"></script>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="bg-soft <%= user.role === 'landlord' ? 'landlord-dashboard-page' : 'student-dashboard-page' %>">
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top shadow-sm">
        <div class="container">
            <a class="navbar-brand brand fw-bold" href="/" aria-label="JacobRent home"><img class="brand-logo" src="/jacobrent-mark.svg" alt="JacobRent J logo">JacobRent</a>
            <div class="d-flex gap-3 align-items-center">
                <a class="nav-link text-dark" href="/properties"><i class="bi bi-buildings me-1"></i>Properties</a>
                <% if (user.role === 'landlord') { %>
                    <a class="nav-link text-dark" href="/add-property"><i class="bi bi-plus-circle me-1"></i>Add Property</a>
                    <a class="nav-link text-dark" href="/bookings"><i class="bi bi-chat-left-text me-1"></i>Bookings</a>
                <% } else if (user.role === 'student') { %>
                    <a class="nav-link text-dark" href="/my-bookings"><i class="bi bi-envelope me-1"></i>My Bookings</a>
                <% } else if (user.role === 'admin') { %>
                    <a class="nav-link text-dark" href="/admin"><i class="bi bi-shield-check me-1"></i>Moderation</a>
                <% } %>
                <a class="nav-link text-dark" href="/profile"><i class="bi bi-person-circle me-1"></i>Profile</a>
                <a class="nav-link text-dark" href="/logout"><i class="bi bi-box-arrow-right me-1"></i>Logout</a>
            </div>
        </div>
    </nav>

    <main class="container dashboard-shell py-5">
        <% const paidBookings = user.role === 'student' ? bookings.filter(booking => booking.paymentStatus === 'paid') : []; %>
        <% const activeStays = paidBookings.filter(booking => booking.status === 'approved' && booking.subscriptionExpiresAt && new Date(booking.subscriptionExpiresAt) > new Date()); %>
        <% const nextExpiry = activeStays.map(booking => new Date(booking.subscriptionExpiresAt)).sort((first, second) => first - second)[0]; %>
        <% const newRequests = user.role === 'landlord' ? bookings.filter(booking => booking.status === 'pending').length : 0; %>
        <% if (user.role === 'student' && typeof bookingResult !== 'undefined' && bookingResult === 'cancelled') { %>
            <div class="alert alert-success" role="status">Your booking is cancelled and the property has been released if no other active booking remains.</div>
        <% } %>
        <section class="dashboard-welcome dashboard-welcome-<%= user.role %> mb-4">
            <div class="dashboard-welcome-copy">
                <span class="eyebrow text-uppercase"><%= user.role === 'landlord' ? 'Landlord workspace' : 'Student workspace' %></span>
                <h1>Good to see you, <%= user.name.split(' ')[0] %>.</h1>
                <p><%= user.role === 'landlord' ? 'Your properties, requests, and next actions in one place.' : 'Your stays and next steps, all in one place.' %></p>
                <a href="<%= user.role === 'landlord' ? '/add-property' : '/properties' %>" class="btn btn-light dashboard-welcome-action">
                    <i class="bi bi-<%= user.role === 'landlord' ? 'plus-circle' : 'search' %> me-2"></i><%= user.role === 'landlord' ? 'Add a property' : 'Explore homes' %>
                </a>
            </div>
            <div class="dashboard-welcome-art" aria-hidden="true"><i class="bi bi-<%= user.role === 'landlord' ? 'buildings-fill' : 'house-heart-fill' %>"></i></div>
        </section>

        <div class="row g-3 mb-5 dashboard-overview dashboard-overview-<%= user.role %>">
            <div class="col-12 col-sm-6 col-lg-4">
                <div class="dashboard-stat-card dashboard-account-stat">
                    <span class="dashboard-stat-icon coral"><i class="bi bi-person-check-fill"></i></span>
                    <div><small>Account</small><strong><%= user.role === 'landlord' ? 'Landlord account' : 'Student account' %></strong><em><%= user.email %></em></div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-lg-4">
                <div class="dashboard-stat-card dashboard-primary-stat">
                    <span class="dashboard-stat-icon blue"><i class="bi bi-<%= user.role === 'landlord' ? 'buildings' : 'chat-heart' %>"></i></span>
                    <div><small><%= user.role === 'landlord' ? 'Your properties' : 'Active stays' %></small><strong><%= user.role === 'landlord' ? properties.length : activeStays.length %></strong><em><%= user.role === 'landlord' ? `${properties.filter(property => property.verificationStatus === 'verified').length} verified` : 'paid and in date' %></em></div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-lg-4">
                <div class="dashboard-stat-card dashboard-activity-stat">
                    <span class="dashboard-stat-icon green"><i class="bi bi-<%= user.role === 'landlord' ? 'inbox' : 'calendar-check' %>"></i></span>
                    <div>
                        <small><%= user.role === 'landlord' ? 'New requests' : 'Next expiry' %></small>
                        <% if (user.role === 'landlord') { %>
                            <strong><%= newRequests %></strong><em><%= newRequests === 1 ? 'needs your attention' : 'need your attention' %></em>
                        <% } else { %>
                            <strong><%= nextExpiry ? nextExpiry.toLocaleDateString() : 'None yet' %></strong><em><%= nextExpiry ? 'upcoming stay expiry' : 'shown when you book a home' %></em>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>

        <% if (user.role === 'landlord') { %>
            <div class="section-head dashboard-section-heading">
                <div><span class="eyebrow text-uppercase">Portfolio</span><h2>Your listings</h2></div>
                <a href="/add-property" class="btn btn-primary"><i class="bi bi-plus-lg me-2"></i>Add property</a>
            </div>
            <div class="airbnb-dashboard-list">
                <% if (!properties.length) { %>
                    <div class="dashboard-empty"><i class="bi bi-house-add"></i><div><strong>Your first listing starts here.</strong><p>Add a property and it will appear in your inventory.</p></div><a href="/add-property" class="text-link">Get started</a></div>
                <% } %>
                <% properties.forEach(property => { %>
                    <div class="airbnb-list-row">
                        <a class="airbnb-row-link" href="/property/<%= property._id %>">
                            <span class="dashboard-list-thumb"><% if (property.videoPosterUrl) { %><img src="<%= property.videoPosterUrl %>" alt="Preview of <%= property.title %>" loading="lazy"><% } else if (property.images && property.images.length) { %><img src="<%= property.images[0] %>" alt="" loading="lazy"><% } else { %><i class="bi bi-house"></i><% } %></span>
                            <span>
                                <strong><%= property.title %></strong>
                                <small><%= property.location %> · ₦<%= property.price.toLocaleString() %>/month</small>
                            </span>
                        </a>
                        <span class="dashboard-property-status">
                            <span class="pill pill-<%= property.verificationStatus %>"><%= property.verificationStatus %></span>
                            <span class="pill <%= property.status === 'available' ? 'pill-paid' : property.status === 'rented' ? 'pill-viewed' : 'pill-pending' %>"><%= property.status === 'rented' ? 'booked' : property.status %></span>
                        </span>
                        <a href="/property/<%= property._id %>/edit" class="text-link">Edit</a>
                    </div>
                <% }) %>
            </div>

            <div class="section-head dashboard-section-heading mt-4">
                <div><span class="eyebrow text-uppercase">Activity</span><h2>Recent bookings</h2></div>
                <a href="/bookings" class="text-link">View inbox →</a>
            </div>
            <div class="airbnb-dashboard-list">
                <% if (!bookings.length) { %>
                    <div class="dashboard-empty"><i class="bi bi-chat-square-heart"></i><div><strong>No bookings yet.</strong><p>Student interest will appear here.</p></div></div>
                <% } %>
                <% bookings.slice(0, 3).forEach(booking => { %>
                    <div class="airbnb-list-row">
                        <span class="airbnb-avatar"><%= booking.studentId ? booking.studentId.name.substring(0, 1).toUpperCase() : '?' %></span>
                        <span>
                            <strong><%= booking.studentId ? booking.studentId.name : 'Student' %></strong>
                            <small><%= booking.propertyId ? booking.propertyId.title : 'Property unavailable' %></small>
                        </span>
                        <span class="pill pill-<%= booking.status %>"><%= booking.status %></span>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="section-head dashboard-section-heading mt-4">
                <div><span class="eyebrow text-uppercase">Your places</span><h2>Your stays</h2></div>
                <a href="/my-bookings" class="text-link">View all →</a>
            </div>
            <div class="airbnb-dashboard-list">
                <% if (!paidBookings.length) { %>
                    <div class="dashboard-empty"><i class="bi bi-compass"></i><div><strong>You have no booked homes yet.</strong><p>When you find the right place, book it securely from its listing.</p></div><a href="/properties" class="text-link">Find a home</a></div>
                <% } %>
                <% paidBookings.slice(0, 3).forEach(booking => { const expiresAt = booking.subscriptionExpiresAt ? new Date(booking.subscriptionExpiresAt) : null; const subscriptionExpired = booking.status === 'expired' || (expiresAt && expiresAt <= new Date()); const bookingCancelled = booking.status === 'cancelled'; %>
                    <div class="airbnb-list-row booked-home-row">
                        <a class="airbnb-row-link" href="<%= booking.propertyId ? '/property/' + booking.propertyId._id : '/my-bookings' %>">
                            <span class="dashboard-list-thumb">
                                <% if (booking.propertyId && booking.propertyId.videoPosterUrl) { %>
                                    <img src="<%= booking.propertyId.videoPosterUrl %>" alt="Preview of <%= booking.propertyId.title %>" loading="lazy">
                                <% } else if (booking.propertyId && booking.propertyId.images && booking.propertyId.images.length) { %>
                                    <img src="<%= booking.propertyId.images[0] %>" alt="<%= booking.propertyId.title %>">
                                <% } else { %>
                                    <i class="bi bi-house"></i>
                                <% } %>
                            </span>
                            <span class="booked-home-copy">
                                <strong><%= booking.propertyId ? booking.propertyId.title : 'Property unavailable' %></strong>
                                <small><%= booking.propertyId ? booking.propertyId.location : '' %></small>
                                <small class="booked-home-expiry"><i class="bi bi-calendar3 me-1"></i><%= expiresAt ? (subscriptionExpired ? 'Expired ' : 'Expires ') + expiresAt.toLocaleDateString() : 'Expiry unavailable' %></small>
                            </span>
                        </a>
                        <div class="booked-home-actions">
                            <span class="pill <%= subscriptionExpired ? 'pill-expired' : bookingCancelled ? 'pill-cancelled' : 'pill-paid' %>"><%= subscriptionExpired ? 'Expired' : bookingCancelled ? 'Cancelled' : 'Booked' %></span>
                            <% if (!subscriptionExpired && !bookingCancelled) { %>
                                <form method="POST" action="/payments/bookings/<%= booking._id %>/cancel" onsubmit="return confirm('Cancel this booking? This does not issue an automatic refund, and the home may become available to another student.');">
                                    <button class="btn btn-outline-danger btn-sm" type="submit">Cancel booking</button>
                                </form>
                            <% } else if (booking.propertyId && booking.propertyId.status === 'available') { %>
                                <form method="POST" action="/payments/properties/<%= booking.propertyId._id %>/initialize">
                                    <button class="btn btn-primary btn-sm" type="submit"><i class="bi bi-arrow-repeat me-1"></i>Rebook</button>
                                </form>
                            <% } else if (booking.propertyId && booking.propertyId.status === 'rented') { %>
                                <button class="btn btn-secondary btn-sm" type="button" disabled>Booked</button>
                            <% } %>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </main>
    <%- include('partials/legal-footer') %>
</body>
</html>
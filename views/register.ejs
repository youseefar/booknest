<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Register' %> - FUTB Housing</title>
    <link rel="icon" type="image/png" href="/futb-crest.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <script src="/js/theme.js"></script>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="bg-soft auth-page-body auth-page-with-nav">
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top shadow-sm">
        <div class="container">
            <a class="navbar-brand brand fw-bold" href="/" aria-label="FUTB Housing home"><img class="brand-logo" src="/futb-crest.png" alt="Federal University of Technology Babura crest">FUTB <span class="text-success">Housing</span></a>
            <div class="d-flex gap-3 align-items-center">
                <a class="nav-link text-dark" href="/"><i class="bi bi-house-door me-1"></i>Home</a>
                <a class="nav-link text-dark" href="/properties"><i class="bi bi-buildings me-1"></i>Browse homes</a>
            </div>
        </div>
    </nav>
    <div class="container auth-form-layout d-flex justify-content-center align-items-center">
        <div class="auth-card">
            <div class="text-center mb-4">
                <span class="eyebrow text-uppercase">Join the community</span>
                <h1 class="fw-bold mb-2">Create your student account</h1>
                <p class="text-muted mb-0"><%= returnTo ? 'Create your account to continue booking your selected home.' : 'Create an account and start finding your next home.' %></p>
            </div>

            <% if (typeof message !== 'undefined' && message) { %>
                <div class="alert alert-danger"><%= message %></div>
            <% } %>

            <form method="POST" action="/register" class="row g-3">
                <input type="hidden" name="role" value="student">
                <% if (typeof returnTo !== 'undefined' && returnTo) { %><input type="hidden" name="returnTo" value="<%= returnTo %>"><% } %>
                <div class="col-12">
                    <label class="form-label" for="name">Full name</label>
                    <input id="name" type="text" name="name" class="form-control" placeholder="Your full name" required>
                </div>
                <div class="col-12">
                    <label class="form-label" for="email">Email address</label>
                    <input id="email" type="email" name="email" class="form-control" placeholder="you@example.com" required>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="password">Password</label>
                    <input id="password" type="password" name="password" class="form-control" placeholder="At least 6 characters" minlength="6" data-password-strength required>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="confirmPassword">Confirm</label>
                    <input id="confirmPassword" type="password" name="confirmPassword" class="form-control" placeholder="Repeat password" data-password-confirm="password" required>
                </div>
                <div class="col-12 pt-2">
                    <button type="submit" class="btn btn-primary w-100">Create student account</button>
                </div>
            </form>

            <p class="text-center small text-muted mt-4 mb-0">Already registered? <a href="/login" class="text-link">Login here</a></p>
        </div>
    </div>
    <%- include('partials/legal-footer') %>
</body>

</html>
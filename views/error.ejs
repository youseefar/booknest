<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/png" href="/futb-crest.png">
    <title><%= title %> - FUTB Housing</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <script src="/js/theme.js"></script>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-soft">
    <main class="container friendly-error-page">
        <a class="friendly-error-brand" href="/" aria-label="FUTB Housing home">
            <img src="/futb-crest.png" alt="">
            <span>FUTB <strong>Housing</strong></span>
        </a>
        <section class="friendly-error-content" role="alert">
            <span class="friendly-error-code"><i class="bi bi-exclamation-circle" aria-hidden="true"></i> <%= statusCode %></span>
            <h1><%= title %></h1>
            <p class="friendly-error-message"><%= message %></p>
            <p class="friendly-error-detail"><%= detail %></p>
            <div class="friendly-error-actions">
                <a class="btn btn-primary" href="<%= backUrl %>"><i class="bi bi-arrow-left me-2" aria-hidden="true"></i><%= backLabel %></a>
                <a class="btn btn-outline-secondary" href="/">Go to home</a>
            </div>
        </section>
        <%- include('partials/legal-footer') %>
    </main>
</body>
</html>
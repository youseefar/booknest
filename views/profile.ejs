<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Profile - FUTB Housing</title>
    <link rel="icon" type="image/png" href="/futb-crest.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <script src="/js/theme.js"></script>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-soft">
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top shadow-sm">
        <div class="container">
            <a class="navbar-brand brand fw-bold" href="/" aria-label="FUTB Housing home"><img class="brand-logo" src="/futb-crest.png" alt="Federal University of Technology Babura crest">FUTB <span class="text-success">Housing</span></a>
            <div class="d-flex gap-3 align-items-center"><a class="nav-link text-dark" href="/dashboard"><i class="bi bi-speedometer2 me-1"></i>Dashboard</a><a class="nav-link text-dark" href="/logout"><i class="bi bi-box-arrow-right me-1"></i>Logout</a></div>
        </div>
    </nav>
    <main class="container profile-page py-5">
        <section class="profile-hero mb-4"><div class="profile-avatar"><%= user.name.substring(0, 1).toUpperCase() %></div><div><span class="eyebrow text-uppercase">Your account</span><h1><%= user.name %></h1><p><%= user.role %> account · Member since <%= new Date(user.createdAt).toLocaleDateString() %></p></div></section>
        <% if (typeof message !== 'undefined' && message) { %><div class="alert alert-danger"><%= message %></div><% } %>
        <% if (typeof success !== 'undefined' && success) { %><div class="alert alert-success"><%= success %></div><% } %>
        <% if (typeof payoutSetup !== 'undefined' && payoutSetup && user.role === 'landlord' && (!user.payoutSubaccountCode || user.payoutSubaccountMode !== paystackMode)) { %>
            <div class="alert alert-info" role="status">Complete your payout setup below. Choose your bank and enter your account number; Paystack will verify the account name before it can receive rental payments.</div>
        <% } %>
        <div class="row g-4">
            <div class="col-lg-7"><section class="profile-panel"><div class="profile-panel-heading"><div><span class="eyebrow text-uppercase">Personal details</span><h2>Manage your profile</h2></div><i class="bi bi-person-gear"></i></div><form method="POST" action="/profile" class="row g-3"><div class="col-12"><label class="form-label" for="name">Full name</label><input id="name" name="name" class="form-control" value="<%= user.name %>" required minlength="2"></div><div class="col-12"><label class="form-label" for="email">Email address</label><input id="email" type="email" name="email" class="form-control" value="<%= user.email %>" required></div><div class="col-12"><label class="form-label" for="phone">Phone number</label><input id="phone" type="tel" name="phone" class="form-control" value="<%= user.phone || '' %>" placeholder="Your contact number"></div><div class="col-12"><button class="btn btn-primary" type="submit"><i class="bi bi-check2 me-2"></i>Save profile</button></div></form></section></div>
            <div class="col-lg-5"><section class="profile-panel"><div class="profile-panel-heading"><div><span class="eyebrow text-uppercase">Security</span><h2>Change password</h2></div><i class="bi bi-lock"></i></div><form method="POST" action="/profile/password" class="row g-3"><div class="col-12"><label class="form-label" for="currentPassword">Current password</label><input id="currentPassword" type="password" name="currentPassword" class="form-control" required></div><div class="col-12"><label class="form-label" for="newPassword">New password</label><input id="newPassword" type="password" name="newPassword" class="form-control" minlength="6" data-password-strength required></div><div class="col-12"><label class="form-label" for="confirmPassword">Confirm new password</label><input id="confirmPassword" type="password" name="confirmPassword" class="form-control" minlength="6" data-password-confirm="newPassword" required></div><div class="col-12"><button class="btn btn-outline-dark" type="submit"><i class="bi bi-shield-lock me-2"></i>Change password</button></div></form></section></div>
        </div>
        <% if (user.role === 'landlord') { %>
            <section class="profile-panel mt-4">
                <div class="profile-panel-heading">
                    <div><span class="eyebrow text-uppercase">Rental payouts</span><h2>Bank account</h2></div>
                    <i class="bi bi-bank"></i>
                </div>
                <% if (user.payoutSubaccountCode && user.payoutSubaccountMode === paystackMode) { %>
                    <p class="text-muted">Verified for <strong><%= user.payoutAccountName %></strong> at <strong><%= user.payoutBankName %></strong> ····<%= user.payoutAccountLast4 %>.</p>
                    <p class="small text-muted">Your rental payment share is sent to this account through Paystack.</p>
                <% } else if (user.payoutSubaccountCode) { %>
                    <div class="alert alert-warning">Reconnect your payout account for this payment environment before accepting payments.</div>
                <% } %>
                <form id="payout-account-form" class="row g-3" method="POST" action="/payments/payout-account" data-selected-bank="<%= user.payoutBankCode || '' %>">
                    <div class="col-md-6">
                        <label class="form-label" for="payout-bank">Bank</label>
                        <input id="payout-bank" class="form-control" type="search" list="payout-bank-options" placeholder="Type to search banks" autocomplete="off" required disabled>
                        <datalist id="payout-bank-options"></datalist>
                        <input id="payout-bank-code" name="bankCode" type="hidden">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="payout-account-number">Account number</label>
                        <input id="payout-account-number" name="accountNumber" class="form-control" type="text" inputmode="numeric" autocomplete="off" pattern="[0-9]{10}" minlength="10" maxlength="10" placeholder="10-digit account number" required>
                    </div>
                    <div class="col-12 d-flex flex-wrap align-items-center gap-2">
                        <button id="verify-payout-account" class="btn btn-outline-dark" type="button"><i class="bi bi-shield-check me-2"></i>Verify account</button>
                        <button id="save-payout-account" class="btn btn-primary" type="submit" disabled>Save payout account</button>
                    </div>
                    <input id="verified-account-name" type="hidden" name="verifiedAccountName">
                    <div class="col-12"><p id="payout-account-status" class="small mb-0" role="status" aria-live="polite"></p></div>
                </form>
            </section>
            <script src="/js/payout-account.js" defer></script>
        <% } %>
    </main>
    <%- include('partials/legal-footer') %>
</body>
</html>

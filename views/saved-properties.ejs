<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Saved homes - Jacob Estate</title>
    <link rel="icon" type="image/svg+xml" href="/jacobrent-mark.svg">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/theme.js"></script>
</head>
<body class="bg-soft" data-saved-properties-page="true" data-rendered-saved-ids="<%= properties.map(property => property._id).join(',') %>">
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top shadow-sm">
        <div class="container">
            <a class="navbar-brand brand fw-bold" href="/" aria-label="Jacob Estate home"><img class="brand-logo" src="/jacobrent-mark.svg" alt="Jacob Estate mark">Jacob Estate</a>
            <div class="d-flex gap-3 align-items-center">
                <a class="nav-link text-dark" href="/properties">Browse homes</a>
                <a class="nav-link text-dark" href="/saved-properties" data-saved-properties-link aria-current="page">Saved homes</a>
                <% if (user) { %>
                    <a class="nav-link text-dark" href="/dashboard">Dashboard</a>
                <% } else { %>
                    <a class="nav-link text-dark" href="/login">Sign in</a>
                <% } %>
            </div>
        </div>
    </nav>
    <main class="container py-5">
        <div class="mb-4">
            <span class="eyebrow text-uppercase">Your shortlist</span>
            <h1 class="display-6 fw-bold mb-1">Saved homes</h1>
            <p class="text-muted mb-0">Saved privately on this device. Sign-in is not required.</p>
        </div>
        <p class="text-muted small" role="status"><span data-saved-count><%= properties.length %></span> saved <span data-saved-label><%= properties.length === 1 ? 'home' : 'homes' %></span></p>
        <div class="row g-4">
            <% properties.forEach(property => { %>
                <div class="col-md-6 col-xl-4" data-saved-card>
                    <article class="property-card h-100 overflow-hidden shadow-sm border-0">
                        <a class="property-card-overlay" href="/property/<%= property._id %>" aria-label="View details for <%= property.title %>"></a>
                        <div class="property-image position-relative">
                            <% if (property.videoUrl) { %>
                                <video class="property-card-video" data-lazy-video data-video-preview preload="none" muted loop playsinline aria-hidden="true">
                                    <source src="<%= property.videoUrl %>" type="video/<%= property.videoFormat || 'mp4' %>">
                                </video>
                                <span class="property-video-label"><i class="bi bi-play-circle-fill me-1"></i>Video tour</span>
                            <% } else { %>
                                <div class="d-flex align-items-center justify-content-center w-100 h-100 bg-gradient-rent text-white">
                                    <i class="bi bi-house-fill display-3 opacity-75" aria-hidden="true"></i>
                                </div>
                                <span class="property-video-label"><i class="bi bi-camera-video-off me-1" aria-hidden="true"></i>Video tour coming soon</span>
                            <% } %>
                            <button type="button" class="wish-btn is-saved" data-property-id="<%= property._id %>" data-property-title="<%= property.title %>" aria-label="Remove <%= property.title %> from saved homes" aria-pressed="true">
                                <i class="bi bi-heart-fill" aria-hidden="true"></i>
                            </button>
                        </div>
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="small text-success fw-semibold"><i class="bi bi-geo-alt-fill me-1"></i><%= property.location %> · <%= property.listingType === 'sale' ? 'For sale' : 'For rent' %></span>
                                <span class="price fw-bold text-dark">₦<%= property.price.toLocaleString() %><% if (property.listingType === 'rent') { %><small class="text-muted">/month</small><% } %></span>
                            </div>
                            <h2 class="card-title h4 mb-2"><%= property.title %></h2>
                            <% if (property.bedrooms !== null && property.bedrooms !== undefined || property.bathrooms !== null && property.bathrooms !== undefined) { %>
                                <p class="small text-muted mb-2">
                                    <% if (property.bedrooms !== null && property.bedrooms !== undefined) { %><span class="me-3"><i class="bi bi-door-open me-1"></i><%= property.bedrooms === 0 ? 'Studio' : `${property.bedrooms} bed${property.bedrooms === 1 ? '' : 's'}` %></span><% } %>
                                    <% if (property.bathrooms !== null && property.bathrooms !== undefined) { %><span><i class="bi bi-droplet me-1"></i><%= property.bathrooms %> bath<%= property.bathrooms === 1 ? '' : 's' %></span><% } %>
                                </p>
                            <% } %>
                            <p class="card-text text-muted"><%= property.description.length > 110 ? property.description.substring(0, 110) + '...' : property.description %></p>
                            <a class="btn btn-primary btn-sm" href="/property/<%= property._id %>">View property</a>
                        </div>
                    </article>
                </div>
            <% }); %>
        </div>
        <div class="empty-state mt-4" data-saved-empty <%= properties.length ? 'hidden' : '' %>>
            <strong>No saved homes yet.</strong>
            <p>Tap the heart on a property to keep it on this device.</p>
            <a class="btn btn-primary mt-2" href="/properties">Explore homes</a>
        </div>
    </main>
    <script src="/js/wishlist.js"></script>
    <script src="/js/lazy-videos.js" defer></script>
    <%- include('partials/legal-footer') %>
</body>
</html>

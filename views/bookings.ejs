<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title><%= landlordView ? 'Property Bookings' : 'My Bookings' %> - JacobRent</title>
	<link rel="icon" type="image/svg+xml" href="/jacobrent-mark.svg">
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
	<script src="/js/theme.js"></script>
	<link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-soft">
	<nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top shadow-sm">
		<div class="container">
			<a class="navbar-brand brand fw-bold" href="/" aria-label="JacobRent home"><img class="brand-logo" src="/jacobrent-mark.svg" alt="JacobRent J logo">JacobRent</a>
			<div class="d-flex gap-3 align-items-center inquiry-nav-links">
				<a class="nav-link text-dark" href="/"><i class="bi bi-house-door me-1"></i>Home</a>
				<a class="nav-link text-dark" href="/properties"><i class="bi bi-buildings me-1"></i>Properties</a>
				<a class="nav-link text-dark" href="/dashboard"><i class="bi bi-speedometer2 me-1"></i>Dashboard</a>
				<a class="nav-link text-dark" href="/profile"><i class="bi bi-person-circle me-1"></i>Profile</a>
				<a class="nav-link text-dark" href="/logout"><i class="bi bi-box-arrow-right me-1"></i>Logout</a>
			</div>
		</div>
	</nav>

	<main class="container inquiry-page py-5">
		<section class="inquiry-hero mb-4">
			<div>
				<span class="eyebrow text-uppercase"><%= landlordView ? 'Landlord inbox' : 'Your activity' %></span>
				<h1><%= landlordView ? 'Keep booking requests moving.' : 'Your home search, in one place.' %></h1>
				<p><%= landlordView ? 'Review student interest and respond to people who see potential in your homes.' : 'Keep track of every booking request and its latest status.' %></p>
			</div>
			<div class="inquiry-hero-icon" aria-hidden="true"><i class="bi bi-chat-square-heart-fill"></i></div>
		</section>

		<div class="inquiry-toolbar">
			<div><span class="eyebrow text-uppercase">Inbox overview</span><h2><%= inquiries.length %> <%= inquiries.length === 1 ? 'booking request' : 'booking requests' %></h2></div>
			<a href="<%= landlordView ? '/dashboard' : '/properties' %>" class="btn btn-outline-dark"><i class="bi bi-arrow-left me-2"></i><%= landlordView ? 'Back to dashboard' : 'Browse properties' %></a>
		</div>
		<% if (!landlordView && paymentResult === 'success') { %>
			<div class="alert alert-success d-flex flex-wrap align-items-center justify-content-between gap-2" role="status">
				<span>Payment confirmed. Your booking payment is recorded.</span>
				<% if (receiptReference) { %><a class="btn btn-outline-success btn-sm" href="/payments/receipts/<%= encodeURIComponent(receiptReference) %>"><i class="bi bi-receipt me-1" aria-hidden="true"></i>View receipt</a><% } %>
			</div>
		<% } else if (!landlordView && paymentResult === 'failed') { %>
			<div class="alert alert-warning" role="status">Payment was not completed. Open the home listing to try again.</div>
		<% } else if (!landlordView && paymentResult === 'verify') { %>
			<div class="alert alert-info" role="status">We could not confirm the payment yet. Please check your booking status again shortly.</div>
		<% } else if (!landlordView && paymentResult === 'already-paid') { %>
			<div class="alert alert-info" role="status">This booking has already been paid.</div>
		<% } %>

		<div class="inquiry-list">
			<% if (!inquiries.length) { %>
				<div class="inquiry-empty">
					<span><i class="bi bi-chat-square-text"></i></span>
					<div><strong>No bookings yet.</strong><p><%= landlordView ? 'When a student reaches out, the request will appear here.' : 'When you find a place you love, send a booking request to the landlord.' %></p></div>
					<a href="<%= landlordView ? '/add-property' : '/properties' %>" class="text-link"><%= landlordView ? 'Add a listing' : 'Find a home' %></a>
				</div>
			<% } %>

			<% inquiries.forEach(inquiry => { %>
				<article class="inquiry-card">
					<div class="inquiry-card-head">
						<div class="inquiry-person">
							<span class="inquiry-avatar"><i class="bi bi-<%= landlordView ? 'person' : 'house-heart' %>"></i></span>
							<div>
								<span class="eyebrow"><%= inquiry.propertyId ? inquiry.propertyId.title : 'Property unavailable' %></span>
								<h3><%= landlordView ? (inquiry.studentId ? inquiry.studentId.name : 'Student') : (inquiry.propertyId ? inquiry.propertyId.location : 'Property unavailable') %></h3>
							</div>
						</div>
						<span class="inquiry-status status-<%= inquiry.status %>"><i class="bi bi-circle-fill"></i><%= inquiry.status %></span>
					</div>

					<div class="inquiry-message-wrap">
						<i class="bi bi-quote"></i>
						<p class="inquiry-message"><%= inquiry.message || 'No message provided.' %></p>
					</div>

					<div class="inquiry-card-footer">
						<div class="inquiry-meta">
							<span><i class="bi bi-calendar3 me-1"></i><%= new Date(inquiry.timestamp).toLocaleDateString() %></span>
							<% if (!landlordView && inquiry.paymentStatus === 'paid' && inquiry.subscriptionExpiresAt) { %><span><i class="bi bi-hourglass-split me-1"></i><%= inquiry.status === 'expired' ? 'Expired ' : 'Expires ' %><%= new Date(inquiry.subscriptionExpiresAt).toLocaleDateString() %></span><% } %>
							<% if (landlordView && inquiry.studentId) { %><span><i class="bi bi-envelope me-1"></i><%= inquiry.studentId.email %></span><% } %>
							<% if (!landlordView && inquiry.propertyId && inquiry.propertyId.landlordId) { %><span><i class="bi bi-person me-1"></i><%= inquiry.propertyId.landlordId.name %></span><% } %>
						</div>
						<% if (landlordView) { %>
										<form class="inquiry-update-form" method="POST" action="/bookings/<%= inquiry._id %>/status">
										<label for="status-<%= inquiry._id %>" class="visually-hidden">Update booking status</label>
								<select id="status-<%= inquiry._id %>" name="status" class="form-select form-select-sm">
									<option value="pending" <%= inquiry.status === 'pending' ? 'selected' : '' %>>Pending</option>
									<option value="viewed" <%= inquiry.status === 'viewed' ? 'selected' : '' %>>Viewed</option>
									<option value="approved" <%= inquiry.status === 'approved' ? 'selected' : '' %>>Approve</option>
									<option value="rejected" <%= inquiry.status === 'rejected' ? 'selected' : '' %>>Reject</option>
								</select>
								<button class="btn btn-primary btn-sm" type="submit"><i class="bi bi-check2 me-1"></i>Update</button>
							</form>
										<% } else if (!landlordView && inquiry.paymentStatus === 'paid') { const expiresAt = inquiry.subscriptionExpiresAt ? new Date(inquiry.subscriptionExpiresAt) : null; const stayExpired = inquiry.status === 'expired' || (expiresAt && expiresAt <= new Date()); const stayCancelled = inquiry.status === 'cancelled'; %>
											<div class="booking-stay-actions">
												<% if (inquiry.paymentReference) { %>
													<a class="btn btn-outline-success btn-sm" href="/payments/receipts/<%= encodeURIComponent(inquiry.paymentReference) %>"><i class="bi bi-receipt me-1"></i>View receipt</a>
												<% } %>
												<% if (!stayExpired && !stayCancelled) { %>
													<form method="POST" action="/payments/bookings/<%= inquiry._id %>/cancel" onsubmit="return confirm('Cancel this booking? This does not issue an automatic refund, and the home may become available to another student.');">
														<button class="btn btn-outline-danger btn-sm" type="submit">Cancel booking</button>
													</form>
												<% } else if (inquiry.propertyId && inquiry.propertyId.status === 'available') { %>
													<form method="POST" action="/payments/properties/<%= inquiry.propertyId._id %>/initialize">
														<button class="btn btn-primary btn-sm" type="submit"><i class="bi bi-arrow-repeat me-1"></i>Rebook</button>
													</form>
												<% } else if (inquiry.propertyId && inquiry.propertyId.status === 'rented') { %>
													<button class="btn btn-secondary btn-sm" type="button" disabled>Booked</button>
												<% } %>
											</div>
						<% } %>
					</div>
					<% if (!landlordView && inquiry.paymentHistory && inquiry.paymentHistory.length) { %>
						<div class="booking-previous-receipts">
							<span>Previous receipts</span>
							<% inquiry.paymentHistory.forEach(payment => { if (payment.reference) { %>
								<a href="/payments/receipts/<%= encodeURIComponent(payment.reference) %>"><%= payment.paidAt ? new Date(payment.paidAt).toLocaleDateString() : 'Past payment' %></a>
							<% } }); %>
						</div>
					<% } %>
				</article>
			<% }) %>
		</div>
	</main>
	<%- include('partials/legal-footer') %>
</body>
</html>

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Jacob Estate — Homes to rent and buy</title>
    <link rel="icon" type="image/svg+xml" href="/jacobrent-mark.svg">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <script src="/js/theme.js"></script>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/jacobrent-landing.css?v=1">
</head>

<body class="bg-soft jacobrent-home">
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top shadow-sm">
        <div class="container">
            <a class="navbar-brand brand fw-bold" href="/" aria-label="Jacob Estate home"><img class="brand-logo" src="/jacobrent-mark.svg" alt="Jacob Estate mark">Jacob Estate</a>
            <div class="d-flex gap-3 align-items-center">
                <a class="nav-link text-dark" href="/properties"><i class="bi bi-buildings me-1"></i>Browse homes</a>
                <% if (user) { %>
                    <a class="nav-link text-dark" href="/dashboard"><i class="bi bi-speedometer2 me-1"></i>Dashboard</a>
                    <a class="nav-link text-dark" href="/profile"><i class="bi bi-person-circle me-1"></i>Profile</a>
                    <a class="nav-link text-dark" href="/logout"><i class="bi bi-box-arrow-right me-1"></i>Logout (<%= user.name %>)</a>
                <% } else { %>
                    <a class="nav-link text-dark" href="/login"><i class="bi bi-person-circle me-1"></i>Login</a>
                    <a class="nav-link text-dark" href="/register"><i class="bi bi-person-plus me-1"></i>Register</a>
                <% } %>
            </div>
        </div>
    </nav>

    <main class="container home-landing py-4">
        <section class="airbnb-hero">
            <form class="airbnb-search-box home-search-form" method="GET" action="/properties">
                <label for="home-search">Find a place near you</label>
                <div class="home-search-controls">
                    <span class="home-search-icon" aria-hidden="true"><i class="bi bi-geo-alt"></i></span>
                    <input id="home-search" class="form-control" type="search" name="q" placeholder="Search by area, address, or property name">
                    <button class="btn btn-primary btn-search" type="submit"><i class="bi bi-search me-2"></i>Search homes</button>
                </div>
            </form>

            <div class="airbnb-hero-copy">
                <span class="eyebrow text-uppercase">Jacob Estate properties</span>
                <div class="home-wordmark" aria-label="Jacob Estate">
                    <span class="home-wordmark-bird home-wordmark-bird-one" aria-hidden="true"><i class="bi bi-twitter"></i></span>
                    <span class="home-wordmark-bird home-wordmark-bird-two" aria-hidden="true"><i class="bi bi-twitter"></i></span>
                    <h1><span>Jacob</span><span class="wordmark-housing">Estate</span></h1>
                </div>
                <h2 class="home-hero-heading">A better place to call home.</h2>
                <p>Find your next home with Jacob Estate. Explore verified properties for rent or sale, and connect directly with property owners.</p>
                <div class="airbnb-cta">
                    <a href="/properties" class="btn btn-primary btn-lg"><i class="bi bi-search me-2"></i>Explore homes</a>
                    <% if (!user) { %>
                        <a href="/register/landlord" class="btn btn-outline-dark btn-lg">List your property</a>
                    <% } else if (user.role === 'landlord') { %>
                        <a href="/add-property" class="btn btn-outline-dark btn-lg">Add a listing</a>
                    <% } else { %>
                        <a href="/properties" class="btn btn-outline-dark btn-lg">Browse homes for rent or sale</a>
                    <% } %>
                    <a href="/properties?type=sale" class="btn btn-outline-light btn-lg">Browse homes for sale</a>
                </div>
            </div>
        </section>

        <section class="airbnb-trust mt-4">
            <div class="trust-item"><i class="bi bi-shield-check"></i><span>Verified homes</span></div>
            <div class="trust-item"><i class="bi bi-house-check"></i><span>Rent or buy</span></div>
            <div class="trust-item"><i class="bi bi-star-fill"></i><span>Quality properties</span></div>
            <div class="trust-item"><i class="bi bi-clock-history"></i><span>Fast response</span></div>
        </section>

        <section class="showcase-section">
            <div class="section-title-row">
                <div>
                    <span class="eyebrow text-uppercase">Featured homes</span>
                    <h2>Featured properties</h2>
                    <p class="section-subtitle">Discover homes available to rent and properties available to buy.</p>
                </div>
                <a href="/properties" class="show-all-link">See all homes <i class="bi bi-arrow-right"></i></a>
            </div>

            <div class="row g-4">
                <% if (properties && properties.length) { %>
                    <% properties.forEach(property => { %>
                        <div class="col-md-6 col-xl-4">
                            <a href="<%= property.isPlaceholder ? '/properties' : '/property/' + property._id %>" class="property-link-card">
                                <article class="airbnb-card">
                                    <div class="airbnb-image-wrap">
                                        <% if (property.videoUrl) { %>
                                            <video class="property-card-video" data-lazy-video data-video-preview preload="none" muted loop playsinline aria-hidden="true">
                                                <source src="<%= property.videoUrl %>#t=0.1" type="video/<%= property.videoFormat || 'mp4' %>">
                                            </video>
                                            <span class="property-video-label"><i class="bi bi-play-circle-fill me-1"></i>Video tour</span>
                                        <% } else { %>
                                            <div class="airbnb-placeholder">
                                                <i class="bi bi-house-heart"></i>
                                            </div>
                                        <% } %>
                                        <% if (property.isPlaceholder) { %>
                                            <span class="sample-home-badge"><i class="bi bi-stars me-1"></i>Sample home</span>
                                        <% } %>
                                        <% if (!property.isPlaceholder && property._id) { %>
                                        <button type="button" class="wish-btn" data-property-id="<%= property._id %>" data-property-title="<%= property.title %>" aria-label="Save <%= property.title %> to wishlist" aria-pressed="false">
                                            <i class="bi bi-heart"></i>
                                        </button>
                                        <% } %>
                                    </div>
                                    <div class="airbnb-card-body">
                                        <div class="d-flex justify-content-between align-items-start gap-2">
                                            <div>
                                                <h3><%= property.title %></h3>
                                                <p class="location-line"><i class="bi bi-geo-alt-fill me-1"></i><%= property.location %></p>
                                                <% if (property.averageRating) { %><p class="small text-warning-emphasis mb-0"><i class="bi bi-star-fill me-1"></i><strong><%= property.averageRating.toFixed(1) %></strong><span class="text-muted"> · <%= property.reviews.length %> review<%= property.reviews.length === 1 ? '' : 's' %></span></p><% } %>
                                            </div>
                                            <div class="price-tag">₦<%= property.price.toLocaleString() %><% if (property.listingType === 'rent') { %><span>/month</span><% } %></div>
                                        </div>
                                        <div class="airbnb-meta">
                                            <span><i class="bi bi-house"></i> <%= property.listingType === 'sale' ? 'For sale' : 'For rent' %></span>
                                        </div>
                                    </div>
                                </article>
                            </a>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div class="col-12">
                        <div class="empty-state large-empty">
                            <strong>No properties are available yet.</strong>
                            <p>New verified properties will appear here as soon as owners add them.</p>
                        </div>
                    </div>
                <% } %>
            </div>
        </section>
    </main>

    <script src="/js/wishlist.js"></script>
    <script src="/js/lazy-videos.js" defer></script>

    <footer class="home-footer">
        <div class="container home-footer-inner">
            <a class="home-footer-brand" href="/" aria-label="Jacob Estate home">
                <img class="brand-logo" src="/jacobrent-mark.svg" alt="Jacob Estate mark"><span>Jacob Estate</span>
            </a>
            <p>Find your next home to rent or buy.</p>
            <nav class="home-footer-links" aria-label="Footer navigation">
                <a href="/properties">Browse homes</a>
                <% if (!user) { %>
                    <a href="/register/landlord">List a property</a>
                    <a href="/login">Sign in</a>
                <% } else { %>
                    <a href="/dashboard">Dashboard</a>
                <% } %>
                <a href="/terms">Terms of Service</a>
                <a href="/privacy-policy">Privacy Policy</a>
            </nav>
            <span class="home-footer-copy">&copy; <%= new Date().getFullYear() %> Jacob Estate</span>
        </div>
    </footer>
</body>
</html>
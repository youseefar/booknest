<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Properties - Jacob Estate</title>
    <link rel="icon" type="image/svg+xml" href="/jacobrent-mark.svg">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <script src="/js/theme.js"></script>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="bg-soft">
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top shadow-sm">
        <div class="container">
            <a class="navbar-brand brand fw-bold" href="/" aria-label="Jacob Estate home"><img class="brand-logo" src="/jacobrent-mark.svg" alt="Jacob Estate mark">Jacob Estate</a>
            <div class="d-flex gap-3 align-items-center">
                <a class="nav-link text-dark" href="/"><i class="bi bi-house-door me-1"></i>Home</a>
                <% if (user) { %>
                    <a class="nav-link text-dark" href="/dashboard"><i class="bi bi-speedometer2 me-1"></i>Dashboard</a>
                    <a class="nav-link text-dark" href="/profile"><i class="bi bi-person-circle me-1"></i>Profile</a>
                    <a class="nav-link text-dark" href="/saved-properties" data-saved-properties-link>Saved homes</a>
                    <a class="nav-link text-dark" href="/logout"><i class="bi bi-box-arrow-right me-1"></i>Logout</a>
                <% } else { %>
                    <a class="nav-link text-dark" href="/saved-properties" data-saved-properties-link>Saved homes</a>
                    <a class="nav-link text-dark" href="/login"><i class="bi bi-person-circle me-1"></i>Login</a>
                <% } %>
            </div>
        </div>
    </nav>

    <main class="container py-5">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
            <div>
                <span class="eyebrow text-uppercase">The collection</span>
                <h1 class="display-6 fw-bold mb-1"><%= typeof landlordView !== 'undefined' && landlordView ? 'Your properties' : 'Find your next address' %></h1>
                <p class="text-muted mb-0"><%= typeof landlordView !== 'undefined' && landlordView ? 'Track every listing and its verification status.' : 'Explore verified homes for rent and for sale.' %></p>
            </div>
            <% if (user && user.role === 'landlord') { %>
                <a href="/add-property" class="btn btn-primary btn-lg"><i class="bi bi-plus-circle me-2"></i>Add property</a>
            <% } %>
        </div>

        <form class="property-search-form mb-4" method="GET" action="<%= typeof landlordView !== 'undefined' && landlordView ? '/my-properties' : '/properties' %>" role="search">
            <label class="visually-hidden" for="property-search">Search homes</label>
            <i class="bi bi-search" aria-hidden="true"></i>
            <% if (!(typeof landlordView !== 'undefined' && landlordView)) { %>
                <input id="property-search" class="form-control" type="search" name="q" maxlength="100" value="<%= typeof search !== 'undefined' ? search : '' %>" placeholder="Search by property, area, or address">
                <label class="visually-hidden" for="property-type">Listing type</label>
                <select id="property-type" class="form-select" name="type">
                    <option value="">Rent or buy</option>
                    <option value="rent" <%= typeof listingType !== 'undefined' && listingType === 'rent' ? 'selected' : '' %>>For rent</option>
                    <option value="sale" <%= typeof listingType !== 'undefined' && listingType === 'sale' ? 'selected' : '' %>>For sale</option>
                </select>
            <% } %>
            <label class="visually-hidden" for="property-sort">Sort properties</label>
            <select id="property-sort" class="form-select" name="sort">
                <option value="latest" <%= sort === 'latest' ? 'selected' : '' %>>Newest first</option>
                <option value="price_asc" <%= sort === 'price_asc' ? 'selected' : '' %>>Price: low to high</option>
                <option value="price_desc" <%= sort === 'price_desc' ? 'selected' : '' %>>Price: high to low</option>
            </select>
            <button class="btn btn-primary" type="submit">Search</button>
            <% if ((typeof search !== 'undefined' && search) || (typeof listingType !== 'undefined' && listingType) || sort !== 'latest') { %>
                <a class="btn btn-outline-secondary" href="<%= typeof landlordView !== 'undefined' && landlordView ? '/my-properties' : '/properties' %>">Clear</a>
            <% } %>
        </form>

        <p class="text-muted small mb-3" role="status">
            <strong><%= totalCount.toLocaleString() %></strong> <%= totalCount === 1 ? 'property' : 'properties' %>
            <% if (totalPages > 1) { %> · Page <%= page %> of <%= totalPages %><% } %>
        </p>

        <div class="row g-4">
            <% properties.forEach(property => { %>
                <div class="col-md-6 col-xl-4">
                    <article class="property-card h-100 overflow-hidden shadow-sm border-0">
                        <a class="property-card-overlay" href="/property/<%= property._id %>" aria-label="View details for <%= property.title %>"></a>
                        <div class="property-image position-relative">
                            <% if (property.images && property.images.length) { %>
                                <img src="<%= property.images[0] %>" alt="<%= property.title %>" class="w-100 h-100 object-fit-cover">
                            <% } else { %>
                                <div class="d-flex align-items-center justify-content-center w-100 h-100 bg-gradient-rent text-white">
                                    <i class="bi bi-house-fill display-3 opacity-75"></i>
                                </div>
                            <% } %>
                            <span class="badge position-absolute top-0 end-0 m-3 text-bg-light text-success"><%= property.status === 'sold' ? 'sold' : property.verificationStatus %></span>
                            <button type="button" class="wish-btn" data-property-id="<%= property._id %>" data-property-title="<%= property.title %>" aria-label="Save <%= property.title %> to wishlist" aria-pressed="false">
                                <i class="bi bi-heart" aria-hidden="true"></i>
                            </button>
                        </div>
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="small text-success fw-semibold"><i class="bi bi-geo-alt-fill me-1"></i><%= property.location %> · <%= property.listingType === 'sale' ? 'For sale' : 'For rent' %></span>
                            <span class="price fw-bold text-dark">₦<%= property.price.toLocaleString() %><% if (property.listingType === 'rent') { %><small class="text-muted">/month</small><% } %></span>
                            </div>
                            <h3 class="card-title h4 mb-2"><%= property.title %></h3>
                            <% if (property.bedrooms !== null && property.bedrooms !== undefined || property.bathrooms !== null && property.bathrooms !== undefined) { %>
                                <p class="small text-muted mb-2">
                                    <% if (property.bedrooms !== null && property.bedrooms !== undefined) { %><span class="me-3"><i class="bi bi-door-open me-1"></i><%= property.bedrooms === 0 ? 'Studio' : `${property.bedrooms} bed${property.bedrooms === 1 ? '' : 's'}` %></span><% } %>
                                    <% if (property.bathrooms !== null && property.bathrooms !== undefined) { %><span><i class="bi bi-droplet me-1"></i><%= property.bathrooms %> bath<%= property.bathrooms === 1 ? '' : 's' %></span><% } %>
                                </p>
                            <% } %>
                            <% if (property.averageRating) { %><p class="small text-warning-emphasis mb-2"><i class="bi bi-star-fill me-1"></i><strong><%= property.averageRating.toFixed(1) %></strong><span class="text-muted"> · <%= property.reviews.length %> review<%= property.reviews.length === 1 ? '' : 's' %></span></p><% } %>
                            <p class="card-text text-muted"><%= property.description.length > 110 ? property.description.substring(0, 110) + '...' : property.description %></p>
                            <div class="property-card-actions d-flex justify-content-between align-items-center pt-3 border-top">
                                <span class="muted"><%= property.amenities && property.amenities.length ? property.amenities.length : 0 %> amenities</span>
                                <div class="d-flex align-items-center gap-3">
                                    <% if (property.status === 'sold') { %>
                                        <button type="button" class="btn btn-secondary btn-sm" disabled aria-label="<%= property.title %> is sold">Sold</button>
                                    <% } else if (property.status === 'rented') { %>
                                        <button type="button" class="btn btn-secondary btn-sm" disabled aria-label="<%= property.title %> is rented">Rented</button>
                                    <% } else if (property.listingType === 'sale' && property.status === 'available' && property.verificationStatus === 'verified') { %>
                                        <a href="/property/<%= property._id %>" class="btn btn-primary btn-sm">Contact seller</a>
                                    <% } else if (user && user.role === 'student' && property.status === 'available' && property.verificationStatus === 'verified') { %>
                                        <form method="POST" action="/payments/properties/<%= property._id %>/initialize">
                                            <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-credit-card me-1"></i>Book</button>
                                        </form>
                                    <% } else if (!user && property.listingType === 'rent' && property.status === 'available' && property.verificationStatus === 'verified') { %>
                                        <a href="/login?returnTo=%2Fproperty%2F<%= property._id %>" class="btn btn-primary btn-sm">Book</a>
                                    <% } %>
                                    <a href="/property/<%= property._id %>" class="text-link fw-bold">View details <span>→</span></a>
                                </div>
                            </div>
                        </div>
                    </article>
                </div>
            <% }); %>
        </div>

        <% if (!properties.length) { %>
            <div class="empty-state mt-4">
                <strong><%= search || listingType ? 'No properties match those filters.' : 'No properties here yet.' %></strong>
                <p><%= search || listingType ? 'Try a different search or clear the filters.' : 'New listings will appear in this space.' %></p>
                <% if (search || listingType) { %><a class="btn btn-outline-primary mt-2" href="/properties">Clear filters</a><% } %>
                <% if (typeof landlordView !== 'undefined' && landlordView) { %><a class="btn btn-primary mt-2" href="/add-property">Add your first property</a><% } %>
            </div>
        <% } %>

        <% if (totalPages > 1) { %>
            <nav class="mt-5" aria-label="Property listing pages">
                <ul class="pagination justify-content-center flex-wrap">
                    <% const firstVisiblePage = Math.max(1, page - 2); const lastVisiblePage = Math.min(totalPages, page + 2); %>
                    <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
                        <% if (page > 1) { %>
                            <a class="page-link" href="<%= listingPath %>?q=<%= encodeURIComponent(search || '') %>&type=<%= encodeURIComponent(listingType || '') %>&sort=<%= encodeURIComponent(sort) %>&page=<%= page - 1 %>" aria-label="Previous page">Previous</a>
                        <% } else { %><span class="page-link">Previous</span><% } %>
                    </li>
                    <% for (let pageNumber = firstVisiblePage; pageNumber <= lastVisiblePage; pageNumber++) { %>
                        <li class="page-item <%= pageNumber === page ? 'active' : '' %>">
                            <% if (pageNumber === page) { %>
                                <span class="page-link" aria-current="page"><%= pageNumber %></span>
                            <% } else { %>
                                <a class="page-link" href="<%= listingPath %>?q=<%= encodeURIComponent(search || '') %>&type=<%= encodeURIComponent(listingType || '') %>&sort=<%= encodeURIComponent(sort) %>&page=<%= pageNumber %>"><%= pageNumber %></a>
                            <% } %>
                        </li>
                    <% } %>
                    <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
                        <% if (page < totalPages) { %>
                            <a class="page-link" href="<%= listingPath %>?q=<%= encodeURIComponent(search || '') %>&type=<%= encodeURIComponent(listingType || '') %>&sort=<%= encodeURIComponent(sort) %>&page=<%= page + 1 %>" aria-label="Next page">Next</a>
                        <% } else { %><span class="page-link">Next</span><% } %>
                    </li>
                </ul>
            </nav>
        <% } %>
    </main>
    <script src="/js/wishlist.js"></script>
    <%- include('partials/legal-footer') %>
</body>
</html>
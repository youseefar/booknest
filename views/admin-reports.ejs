<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex">
    <link rel="icon" type="image/svg+xml" href="/jacobrent-mark.svg">
    <title>Listing reports - Jacob Estate</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <script src="/js/theme.js"></script>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-soft">
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top shadow-sm">
        <div class="container">
            <a class="navbar-brand brand fw-bold" href="/admin" aria-label="Admin dashboard"><img class="brand-logo" src="/jacobrent-mark.svg" alt="Jacob Estate mark">Jacob Estate</a>
            <a class="nav-link text-dark" href="/admin"><i class="bi bi-speedometer2 me-1"></i>Admin dashboard</a>
        </div>
    </nav>
    <main class="container py-4">
        <h1 class="h3 fw-bold mb-1">Listing reports</h1>
        <p class="text-muted"><%= openCount %> open. Marking a report reviewed or dismissed is recorded in the audit log. To act on a listing itself, use the moderation page.</p>
        <nav class="d-flex gap-2 mb-3" aria-label="Report status">
            <% ['open', 'reviewed', 'dismissed', 'all'].forEach(name => { %>
                <a class="btn btn-sm <%= filter === name ? 'btn-primary' : 'btn-outline-secondary' %>" href="/admin/reports?status=<%= name %>"<%- filter === name ? ' aria-current="page"' : '' %>><%= name.charAt(0).toUpperCase() + name.slice(1) %></a>
            <% }); %>
        </nav>
        <% if (!reports.length) { %>
            <div class="alert alert-info" role="status">No reports in this view.</div>
        <% } else { %>
            <div class="d-grid gap-3">
                <% reports.forEach(report => { %>
                    <article class="glass-card p-3">
                        <div class="d-flex justify-content-between flex-wrap gap-2">
                            <strong><% if (report.propertyId) { %><a href="/property/<%= report.propertyId._id %>"><%= report.propertyId.title %></a><% } else { %>Listing removed<% } %></strong>
                            <span class="badge text-bg-secondary"><%= report.status %></span>
                        </div>
                        <p class="mb-1"><strong><%= reasons[report.reason] || report.reason %></strong><% if (report.details) { %>: <%= report.details %><% } %></p>
                        <p class="small text-muted mb-2">Reported by <%= report.reporterId ? report.reporterId.name : 'a deleted account' %> on <%= report.createdAt.toLocaleDateString('en-NG', { dateStyle: 'medium' }) %></p>
                        <form method="POST" action="/admin/reports/<%= report._id %>/status?back=<%= filter %>" class="d-flex gap-2 flex-wrap">
                            <% if (report.status !== 'reviewed') { %><button class="btn btn-sm btn-success" name="status" value="reviewed" type="submit">Mark reviewed</button><% } %>
                            <% if (report.status !== 'dismissed') { %><button class="btn btn-sm btn-outline-secondary" name="status" value="dismissed" type="submit">Dismiss</button><% } %>
                            <% if (report.status !== 'open') { %><button class="btn btn-sm btn-outline-primary" name="status" value="open" type="submit">Reopen</button><% } %>
                        </form>
                    </article>
                <% }); %>
            </div>
        <% } %>
    </main>
    <%- include('partials/legal-footer') %>
</body>
</html>

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Property - Jacob Estate</title>
    <link rel="icon" type="image/svg+xml" href="/jacobrent-mark.svg">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <script src="/js/theme.js"></script>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="bg-soft">
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top shadow-sm">
        <div class="container">
            <a class="navbar-brand brand fw-bold" href="/" aria-label="Jacob Estate home"><img class="brand-logo" src="/jacobrent-mark.svg" alt="Jacob Estate mark">Jacob Estate</a>
            <div class="d-flex gap-3 align-items-center">
                <a class="nav-link text-dark" href="/dashboard"><i class="bi bi-speedometer2 me-1"></i>Dashboard</a>
                <a class="nav-link text-dark" href="/profile"><i class="bi bi-person-circle me-1"></i>Profile</a>
                <a class="nav-link text-dark" href="/logout"><i class="bi bi-box-arrow-right me-1"></i>Logout</a>
            </div>
        </div>
    </nav>

    <main class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="glass-card form-card p-4 p-lg-5">
                    <div class="text-center mb-4">
                        <span class="eyebrow text-uppercase">Property workspace</span>
                        <h1 class="display-6 fw-bold mb-2">Add a property</h1>
                        <p class="text-muted mb-0">List your property for rent or for sale.</p>
                    </div>

                    <% if (typeof message !== 'undefined' && message) { %>
                        <div class="alert alert-warning"><%= message %></div>
                    <% } %>

                    <form method="POST" action="/add-property" class="row g-3" enctype="multipart/form-data">
                        <div class="col-md-12">
                            <label class="form-label" for="title">Property title</label>
                            <input class="form-control" id="title" type="text" name="title" maxlength="120" placeholder="e.g. Spacious family home" required>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label" for="listingType">Listing type</label>
                            <select class="form-select" id="listingType" name="listingType" required>
                                <option value="rent">For rent</option>
                                <option value="sale">For sale</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label" for="description">Description</label>
                            <textarea class="form-control" id="description" name="description" rows="5" maxlength="3000" placeholder="Describe the property and what makes it special." required></textarea>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label" for="price">Price <span class="text-muted">(monthly for rent; asking price for sale)</span></label>
                            <input class="form-control" id="price" type="number" name="price" placeholder="₦ 0" min="1" required>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label" for="location">Area / location</label>
                            <input class="form-control" id="location" type="text" name="location" maxlength="120" placeholder="Area or neighborhood" required>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label" for="bedrooms">Bedrooms <span class="text-muted">(optional)</span></label>
                            <input class="form-control" id="bedrooms" type="number" name="bedrooms" min="0" max="50" step="1" inputmode="numeric">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="bathrooms">Bathrooms <span class="text-muted">(optional)</span></label>
                            <input class="form-control" id="bathrooms" type="number" name="bathrooms" min="0" max="50" step="1" inputmode="numeric">
                        </div>

                        <div class="col-12">
                            <label class="form-label" for="address">Street address</label>
                            <input class="form-control" id="address" type="text" name="address" maxlength="240" placeholder="Street address" required>
                        </div>

                        <div class="col-12">
                            <label class="form-label" for="amenities">Amenities <span class="text-muted">(optional)</span></label>
                            <input class="form-control" id="amenities" type="text" name="amenities" placeholder="WiFi, water, parking, generator (optional)">
                        </div>

                        <div class="col-12">
                            <label class="form-label" for="video">Property video <span class="text-muted">(required)</span></label>
                            <input class="form-control" id="video" type="file" name="video" accept="video/mp4,video/quicktime,video/webm" required>
                            <div class="form-text">MP4, MOV, or WebM · maximum 50 MB. Listings use a video tour; photo uploads are not accepted.</div>
                        </div>

                        <div class="col-12 d-grid gap-2 d-md-flex justify-content-md-between pt-3">
                            <a href="/dashboard" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-2"></i>Back</a>
                            <button type="submit" class="btn btn-primary btn-lg px-4"><i class="bi bi-house-add me-2"></i>Add Property</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </main>
    <%- include('partials/legal-footer') %>
</body>
</html>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Property - FUTB Housing</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <script src="/js/theme.js"></script>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="bg-soft">
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top shadow-sm">
        <div class="container">
            <a class="navbar-brand brand fw-bold" href="/" aria-label="FUTB Housing home"><img class="brand-logo" src="/futb-crest.png" alt="Federal University of Technology Babura crest">FUTB <span class="text-success">Housing</span></a>
            <div class="d-flex gap-3 align-items-center">
                <a class="nav-link text-dark" href="/dashboard"><i class="bi bi-speedometer2 me-1"></i>Dashboard</a>
                <a class="nav-link text-dark" href="/profile"><i class="bi bi-person-circle me-1"></i>Profile</a>
                <a class="nav-link text-dark" href="/logout"><i class="bi bi-box-arrow-right me-1"></i>Logout</a>
            </div>
        </div>
    </nav>

    <main class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="glass-card form-card p-4 p-lg-5">
                    <div class="text-center mb-4">
                        <span class="eyebrow text-uppercase">Landlord studio</span>
                        <h1 class="display-6 fw-bold mb-2">Add a rental property</h1>
                        <p class="text-muted mb-0">Showcase your home with clear details and a warm first impression.</p>
                    </div>

                    <% if (typeof message !== 'undefined' && message) { %>
                        <div class="alert alert-warning"><%= message %></div>
                    <% } %>

                    <form method="POST" action="/add-property" enctype="multipart/form-data" class="row g-3">
                        <div class="col-md-12">
                            <label class="form-label" for="title">Property title</label>
                            <input class="form-control" id="title" type="text" name="title" placeholder="e.g. Bright two-bedroom near campus" required>
                        </div>

                        <div class="col-12">
                            <label class="form-label" for="description">Description</label>
                            <textarea class="form-control" id="description" name="description" rows="5" placeholder="Tell students what makes this home comfortable and convenient." required></textarea>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label" for="price">Monthly price</label>
                            <input class="form-control" id="price" type="number" name="price" placeholder="₦ 0" min="1" required>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label" for="location">Area / location</label>
                            <input class="form-control" id="location" type="text" name="location" placeholder="Babura, FUTB campus" required>
                        </div>

                        <div class="col-12">
                            <label class="form-label" for="address">Street address</label>
                            <input class="form-control" id="address" type="text" name="address" placeholder="No. 12, Learning Street" required>
                        </div>

                        <div class="col-12">
                            <label class="form-label" for="amenities">Amenities</label>
                            <input class="form-control" id="amenities" type="text" name="amenities" placeholder="WiFi, water, parking, generator">
                        </div>

                        <div class="col-12">
                            <label class="form-label" for="images">Property photos</label>
                            <input class="form-control" id="images" type="file" name="images" accept="image/*" multiple>
                            <div class="form-text">Upload up to 5 photos to help students picture the home.</div>
                        </div>

                        <div class="col-12 d-grid gap-2 d-md-flex justify-content-md-between pt-3">
                            <a href="/dashboard" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-2"></i>Back</a>
                            <button type="submit" class="btn btn-primary btn-lg px-4"><i class="bi bi-house-add me-2"></i>Add Property</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </main>
</body>
</html>